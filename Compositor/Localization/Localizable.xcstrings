    "The layer mask couldn’t be converted to 8-bit grayscale and was skipped.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图层蒙版无法转换为 8 位灰度并被跳过。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máscara de capa no se pudo convertir a escala de grises de 8 bits y se omitió."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेयर मास्क को 8-बिट ग्रेस्केल में परिवर्तित नहीं किया जा सका और छोड़ दिया गया।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le masque de calque n’a pas pu être converti en niveaux de gris 8 bits et a été ignoré."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تحويل قناع الطبقة إلى تدرج رمادي 8 بت وتم تخطيه."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máscara de camada não pôde ser convertida para escala de cinza de 8 bits e foi ignorada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маску слоя не удалось преобразовать в 8-битную шкалу серого, и она была пропущена."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile convertire la maschera di livello in scala di grigi a 8 bit ed è stata saltata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーマスクは 8 ビット グレースケールに変換できず、スキップされました。"
          }
        }
      }
    },
    "The layer mask is turned off. Shift-click its thumbnail to turn it on, then paint.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图层蒙版已关闭。按住 Shift 键并单击其缩略图将其打开，然后进行绘制。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La máscara de capa está desactivada. Presione Mayús y haga clic en su miniatura para encenderla y luego pinte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेयर मास्क बंद है. इसे चालू करने के लिए इसके थंबनेल पर शिफ़्ट-क्लिक करें, फिर पेंट करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le masque de calque est désactivé. Maj-cliquez sur sa vignette pour l'activer, puis peignez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف تشغيل قناع الطبقة. انقر مع الضغط على مفتاح Shift على الصورة المصغرة لتشغيلها، ثم قم بالطلاء."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A máscara de camada está desativada. Clique com a tecla Shift pressionada na miniatura para ativá-la e depois pinte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маска слоя отключена. Удерживая клавишу Shift, щелкните его миниатюру, чтобы включить его, а затем раскрасьте."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La maschera di livello è disattivata. Fai clic tenendo premuto il tasto Maiusc sulla sua miniatura per attivarla, quindi dipingi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーマスクはオフになっています。 Shift キーを押しながらサムネイルをクリックしてオンにし、ペイントします。"
          }
        }
      }
    },
