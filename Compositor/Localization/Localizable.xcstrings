    "Line height, baseline to baseline. Empty or 0 is Auto: 120% of the font size.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线高、基线到基线。空或 0 表示自动：字体大小的 120%。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura de línea, línea base a línea base. Vacío o 0 es Auto: 120% del tamaño de fuente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेखा की ऊँचाई, आधार रेखा से आधार रेखा। खाली या 0 स्वतः है: फ़ॉन्ट आकार का 120%।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hauteur de ligne, ligne de base à ligne de base. Vide ou 0 correspond à Auto : 120 % de la taille de la police."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفاع الخط، من خط الأساس إلى خط الأساس. فارغ أو 0 تلقائي: 120% من حجم الخط."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Altura da linha, linha de base a linha de base. Vazio ou 0 é Automático: 120% do tamanho da fonte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высота строки, от базовой линии до базовой линии. Пусто или 0 — это «Авто»: 120 % размера шрифта."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altezza della linea, da linea di base a linea di base. Vuoto o 0 è Auto: 120% della dimensione del carattere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行の高さ、ベースラインからベースラインまで。空または 0 は自動です: フォント サイズの 120%。"
