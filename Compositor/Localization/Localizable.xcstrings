    "Resizes layer pixels and applies existing transforms. Undo restores the originals.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整图层像素大小并应用现有变换。撤消可恢复原始状态。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el tamaño de los píxeles de la capa y aplica transformaciones existentes. Deshacer restaura los originales."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परत पिक्सेल का आकार बदलता है और मौजूदा परिवर्तनों को लागू करता है। पूर्ववत करें मूल को पुनर्स्थापित करता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Redimensionne les pixels du calque et applique les transformations existantes. Annuler restaure les originaux."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغير حجم وحدات البكسل في الطبقة ويطبق التحويلات الموجودة. التراجع يعيد النسخ الأصلية."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Redimensiona os pixels da camada e aplica as transformações existentes. Desfazer restaura os originais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяет размер пикселей слоя и применяет существующие преобразования. Отменить восстанавливает оригиналы."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridimensiona i pixel del livello e applica le trasformazioni esistenti. Annulla ripristina gli originali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーピクセルのサイズを変更し、既存の変換を適用します。元に戻すと元の状態に戻ります。"
          }
        }
      }
    },
