    "Positive straightens lines that bow outward (barrel); negative, lines that bow inward (pincushion).": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值拉直向外弯曲的线条（桶形）；负向，向内弯曲的线条（枕形）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Positivo endereza las líneas que se inclinan hacia afuera (barril); Negativo, líneas que se inclinan hacia adentro (alfiletero)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सकारात्मक उन रेखाओं को सीधा करता है जो बाहर की ओर झुकती हैं (बैरल); नकारात्मक, रेखाएँ जो अंदर की ओर झुकती हैं (पिनकुशन)।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le positif redresse les lignes qui s'inclinent vers l'extérieur (baril) ; négatif, lignes qui s'inclinent vers l'intérieur (coussin à épingles)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيجابي يصحح الخطوط التي تنحني للخارج (البرميل) ؛ الخطوط السلبية التي تنحني إلى الداخل (وسادة مدبسة)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Positivo endireita linhas que se curvam para fora (barril); negativo, linhas que se curvam para dentro (almofada de alfinetes)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позитив выпрямляет линии, выгибающиеся наружу (бочонок); негатив, линии, наклоненные внутрь (подушечка для иголок)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il positivo raddrizza le linee che si curvano verso l'esterno (barile); negativo, linee che si incurvano verso l'interno (puntaspilli)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値は、外側に曲がったライン (バレル) をまっすぐにします。ネガティブ、内側に曲がった線 (糸巻き型)。"
          }
        }
      }
    },
    "Positive values tighten the detected mask inward; negative values expand it outward": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正值将检测到的掩模向内拉紧；负值将其向外扩展"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores positivos aprietan la máscara detectada hacia adentro; los valores negativos lo expanden hacia afuera"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सकारात्मक मान पहचाने गए मास्क को अंदर की ओर कसते हैं; नकारात्मक मूल्य इसे बाहर की ओर विस्तारित करते हैं"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs positives resserrent le masque détecté vers l'intérieur ; les valeurs négatives l'étendent vers l'extérieur"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القيم الإيجابية تشد القناع المكتشف إلى الداخل؛ القيم السلبية توسعها إلى الخارج"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Valores positivos apertam a máscara detectada para dentro; valores negativos expandem para fora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положительные значения стягивают обнаруженную маску внутрь; отрицательные значения расширяют его наружу"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori positivi stringono la maschera rilevata verso l'interno; i valori negativi lo espandono verso l'esterno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正の値を指定すると、検出されたマスクが内側に締め付けられます。負の値を指定すると外側に拡張されます"
          }
        }
      }
    },
    "Preserve Luminosity": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持亮度"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preservar la luminosidad"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चमक बनाए रखें"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préserver la luminosité"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحفاظ على اللمعان"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preservar a luminosidade"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить яркость"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva la luminosità"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明るさを維持する"
          }
        }
      }
    },
    "Preserves colored edges while color noise is reduced.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留彩色边缘，同时减少色彩噪点。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva los bordes coloreados mientras se reduce el ruido del color."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रंगीन किनारों को सुरक्षित रखता है जबकि रंग शोर कम हो जाता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préserve les bords colorés tout en réduisant le bruit de couleur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ على الحواف الملونة مع تقليل تشويش اللون."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva as bordas coloridas enquanto o ruído da cor é reduzido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет цветные края и снижает цветовой шум."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva i bordi colorati riducendo il rumore cromatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カラーノイズを低減しながら、カラーエッジを保持します。"
          }
        }
      }
    },
    "Preserves fine texture while luminance noise is reduced.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留精细纹理，同时减少亮度噪点。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la textura fina mientras se reduce el ruido de luminancia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चमकदार शोर कम होने पर बढ़िया बनावट बरकरार रहती है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préserve la texture fine tout en réduisant le bruit de luminance."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ على الملمس الناعم مع تقليل ضوضاء النصوع."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preserva a textura fina enquanto o ruído de luminância é reduzido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет тонкую текстуру при уменьшении яркостного шума."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la texture fine mentre il rumore della luminanza viene ridotto."
          }
        },
        "ja": {
