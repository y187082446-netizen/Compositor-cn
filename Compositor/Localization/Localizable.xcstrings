        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تحديد عدة طبقات. اختر واحدة فقط لترسم عليها."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Várias camadas são selecionadas. Selecione apenas um para pintar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрано несколько слоев. Выберите только один, чтобы нарисовать на нем."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono selezionati più livelli. Selezionane solo uno per dipingerlo."
