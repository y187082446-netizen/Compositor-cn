    "Firmer color than Version 2. Primary shifts stay gentler than the current process.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色比版本 2 更坚固。主要转变比当前过程更柔和。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Color más firme que la versión 2. Los cambios primarios siguen siendo más suaves que el proceso actual."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण 2 की तुलना में अधिक मजबूत रंग। प्राथमिक बदलाव वर्तमान प्रक्रिया की तुलना में नरम रहते हैं।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleur plus ferme que la version 2. Les changements primaires restent plus doux que le processus actuel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لون أكثر ثباتًا من الإصدار 2. تظل التحولات الأساسية ألطف من العملية الحالية."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cor mais firme que a versão 2. As mudanças primárias permanecem mais suaves que o processo atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более стойкий цвет, чем в версии 2. Первичные изменения остаются более мягкими, чем текущий процесс."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colore più solido rispetto alla versione 2. I cambiamenti primari rimangono più delicati rispetto al processo attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン 2 よりもしっかりした色。プライマリ シフトは現在のプロセスより穏やかなままです。"
          }
        }
      }
