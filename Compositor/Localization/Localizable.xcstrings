    "Off leaves the picture as it is. Guided straightens from lines you draw on the picture.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭使图片保持原样。引导从您在图片上绘制的线条拉直。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Off deja la imagen como está. Enderezamiento guiado a partir de líneas que dibujas en la imagen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र को वैसे ही छोड़ देता है जैसे वह है। चित्र पर आपके द्वारा खींची गई रेखाओं से निर्देशित सीधा हो जाता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé laisse l'image telle quelle. Redressement guidé à partir des lignes que vous dessinez sur l'image."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Off يترك الصورة كما هي. يتم التقويم الموجه من الخطوط التي ترسمها على الصورة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Off deixa a imagem como está. Endireitamentos guiados a partir das linhas que você desenha na imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выкл. оставляет изображение таким, какое оно есть. Управляемое выпрямление по линиям, которые вы рисуете на картинке."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Off lascia l'immagine così com'è. Raddrizzamento guidato dalle linee tracciate sull'immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフでは画像はそのままになります。ガイド付きで、画像上に描いた線をまっすぐにします。"
          }
        }
      }
    },
