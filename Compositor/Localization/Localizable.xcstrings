    "Lifts or lowers the brightest tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提升或降低最亮的色调。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube o baja los tonos más brillantes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे चमकीले स्वरों को उठाता या कम करता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmente ou diminue les tons les plus brillants."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرفع أو يخفض النغمات الأكثر سطوعًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta ou diminui os tons mais brilhantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поднимает или понижает самые яркие тона."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza o abbassa i toni più brillanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も明るいトーンを上げたり下げたりします。"
          }
        }
      }
    },
