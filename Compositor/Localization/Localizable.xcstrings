    "Adjusts the bright parts of the picture. Hold Option to see clipped highlights.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整图片的明亮部分。按住 Option 可查看剪切的高光。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta las partes brillantes de la imagen. Mantenga presionada la opción para ver los aspectos más destacados recortados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र के चमकीले भागों को समायोजित करता है। क्लिप किए गए हाइलाइट्स देखने के लिए विकल्प दबाए रखें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste les parties lumineuses de l’image. Maintenez Option pour voir les faits saillants coupés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط الأجزاء الساطعة من الصورة. اضغط مع الاستمرار على الخيار لرؤية النقاط البارزة المقطوعة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta as partes brilhantes da imagem. Segure Opção para ver os destaques cortados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регулирует яркие части изображения. Удерживайте Option, чтобы увидеть обрезанные блики."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola le parti luminose dell'immagine. Tieni premuto Opzione per vedere le luci ritagliate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の明るい部分を調整します。 Option を押し続けると、クリップされたハイライトが表示されます。"
          }
        }
      }
    },
    "Adjusts the dark parts of the picture. Hold Option to see clipped shadows.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
