    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下拖动可提高或降低这些音调。沿底部拖动分隔线以更改每个区域覆盖的音调。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre hacia arriba o hacia abajo para subir o bajar esos tonos. Arrastre un divisor en la parte inferior para cambiar los tonos que cubre cada región."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन स्वरों को उठाने या नीचे करने के लिए ऊपर या नीचे खींचें। प्रत्येक क्षेत्र को कवर करने वाले टोन को बदलने के लिए नीचे की ओर एक डिवाइडर खींचें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser vers le haut ou vers le bas pour augmenter ou diminuer ces tons. Faites glisser un séparateur en bas pour modifier les tons couverts par chaque région."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لأعلى أو لأسفل لرفع تلك النغمات أو خفضها. اسحب فاصلًا على طول الجزء السفلي لتغيير النغمات التي تغطيها كل منطقة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para cima ou para baixo para aumentar ou diminuir esses tons. Arraste um divisor na parte inferior para alterar quais tons cada região cobre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите вверх или вниз, чтобы повысить или понизить эти тона. Перетащите разделитель внизу, чтобы изменить тона, которые охватывает каждый регион."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina verso l'alto o verso il basso per alzare o abbassare i toni. Trascina un divisore nella parte inferiore per modificare i toni coperti da ciascuna regione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下にドラッグしてトーンを上げたり下げたりします。下部に沿って分割線をドラッグして、各領域がカバーするトーンを変更します。"
          }
        }
      }
    },
