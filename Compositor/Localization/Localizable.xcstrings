        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिये के अंदर खींचें. कोण रंग निर्धारित करता है, दूरी संतृप्ति निर्धारित करती है।"
          }
        },
        "fr": {
          "stringUnit": {
