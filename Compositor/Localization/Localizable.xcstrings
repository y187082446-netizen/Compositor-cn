    "Hue around the wheel, saturation outward from the center. Control-click to show the histogram.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色轮周围的色调，从中心向外的饱和度。按住 Control 键单击以显示直方图。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tono alrededor de la rueda, saturación hacia afuera desde el centro. Mantenga presionada la tecla Control y haga clic para mostrar el histograma."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिये के चारों ओर रंग, केंद्र से बाहर की ओर संतृप्ति। हिस्टोग्राम दिखाने के लिए कंट्रोल-क्लिक करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte autour de la roue, saturation vers l'extérieur à partir du centre. Ctrl-clic pour afficher l'histogramme."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هوى حول العجلة، والتشبع إلى الخارج من المركز. انقر مع الضغط على مفتاح التحكم لإظهار الرسم البياني."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Matiz ao redor da roda, saturação para fora do centro. Clique com a tecla Control pressionada para mostrar o histograma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оттенок вокруг круга, насыщенность наружу от центра. Щелкните, удерживая клавишу Control, чтобы отобразить гистограмму."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonalità attorno alla ruota, saturazione verso l'esterno dal centro. Fai clic tenendo premuto il tasto Control per mostrare l'istogramma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホイール周囲の色合い、中心から外側に向かう彩度。 Control キーを押しながらクリックすると、ヒストグラムが表示されます。"
          }
        }
      }
    },
