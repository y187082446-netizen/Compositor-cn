    "Put each pixel's brightness back afterwards, so only the color moves": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后将每个像素的亮度放回去，这样只有颜色会移动"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego, restablezca el brillo de cada píxel, de modo que solo se mueva el color."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाद में प्रत्येक पिक्सेल की चमक वापस रख दें, ताकि केवल रंग ही चले"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remettez ensuite la luminosité de chaque pixel pour que seule la couleur bouge"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد سطوع كل بكسل مرة أخرى بعد ذلك، بحيث يتحرك اللون فقط"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque o brilho de cada pixel de volta depois, para que apenas a cor se mova"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После этого верните яркость каждого пикселя, чтобы перемещался только цвет."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina successivamente la luminosità di ciascun pixel, in modo che si sposti solo il colore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で各ピクセルの明るさを元に戻すと、色だけが移動します"
          }
        }
      }
    },
