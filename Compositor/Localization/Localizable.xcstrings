    "A little stronger than Version 1. The sliders below still fall well short of the current look.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比版本 1 强一点。下面的滑块仍然远远低于当前的外观。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco más fuerte que la Versión 1. Los controles deslizantes a continuación aún están muy por debajo del aspecto actual."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संस्करण 1 की तुलना में थोड़ा मजबूत। नीचे दिए गए स्लाइडर अभी भी वर्तमान लुक से काफी पीछे हैं।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un peu plus fort que la version 1. Les curseurs ci-dessous sont encore bien en deçà de l’apparence actuelle."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقوى قليلاً من الإصدار 1. لا تزال أشرطة التمرير أدناه أقل بكثير من المظهر الحالي."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco mais forte que a versão 1. Os controles deslizantes abaixo ainda ficam bem aquém da aparência atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Немного сильнее, чем версия 1. Ползунки ниже по-прежнему не соответствуют текущему виду."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un po' più potente della versione 1. Gli slider sottostanti sono ancora ben al di sotto dell'aspetto attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン 1 よりも少し強化されています。以下のスライダーは、現在の外観にはまだかなり達していません。"
          }
        }
      }
    },
    "A subdivision every %@ pixels.": {
