    "Shrink the mask to drop the rim of background color around the subject, or grow it": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩小蒙版以去除主体周围的背景颜色边缘，或将其放大"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduzca la máscara para eliminar el borde del color de fondo alrededor del sujeto o agréguela"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विषय के चारों ओर पृष्ठभूमि रंग के रिम को गिराने या उसे बड़ा करने के लिए मास्क को सिकोड़ें"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduisez le masque pour laisser tomber le bord de couleur d'arrière-plan autour du sujet ou agrandissez-le."
