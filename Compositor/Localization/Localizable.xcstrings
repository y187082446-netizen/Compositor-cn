    "The smart object was rasterized. Linked contents can’t be edited.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "智能对象被光栅化。链接内容无法编辑。"
          }
        },
        "es": {
