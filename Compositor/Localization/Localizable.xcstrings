    "Targeted adjustment: drag on the image to change that color's saturation, or its hue with Command held": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有针对性的调整：在图像上拖动以更改颜色的饱和度或按住 Command 的情况下的色调"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste específico: arrastre la imagen para cambiar la saturación de ese color o su tono con Comando presionado"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लक्षित समायोजन: कमांड दबाकर उस रंग की संतृप्ति, या उसके रंग को बदलने के लिए छवि को खींचें"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustement ciblé : faites glisser sur l'image pour modifier la saturation de cette couleur ou sa teinte en maintenant la commande enfoncée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الضبط المستهدف: اسحب الصورة لتغيير تشبع اللون أو تدرجه مع الاستمرار في الضغط على زر Command"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste direcionado: arraste a imagem para alterar a saturação da cor ou seu matiz com o comando pressionado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Целенаправленная настройка: перетащите изображение, чтобы изменить насыщенность этого цвета или его оттенок, удерживая клавишу Command."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regolazione mirata: trascina sull'immagine per modificare la saturazione di quel colore o la sua tonalità tenendo premuto Comando"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象を絞った調整: コマンドを押したまま画像をドラッグして、その色の彩度または色相を変更します。"
          }
        }
      }
    },
