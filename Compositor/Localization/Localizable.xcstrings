    "This project exceeds the supported canvas, layer, file-size, or %@-megapixel document limit.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该项目超出了支持的画布、图层、文件大小或%@-兆像素文档限制。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proyecto excede el límite de lienzo, capa, tamaño de archivo o documento de %@-megapíxeles admitido."
          }
