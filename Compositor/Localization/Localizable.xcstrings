            "value": "لم يتم تحديد أي أداة · اضغط على مفتاح الأداة لاختيار واحدة · مسافة للتحريك"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma ferramenta selecionada · Pressione a tecla de uma ferramenta para escolher uma · Espaço para deslocar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструмент не выбран · Нажмите клавишу инструмента, чтобы выбрать его · Пробел для панорамирования"
          }
        },
        "it": {
          "stringUnit": {
