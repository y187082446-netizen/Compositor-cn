    "Hide the background behind a layer mask, keeping the foreground subjects. The pixels stay, so the background can be painted back at any time.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将背景隐藏在图层蒙版后面，保留前景主体。像素会保留下来，因此可以随时重新绘制背景。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta el fondo detrás de una máscara de capa, manteniendo los sujetos en primer plano. Los píxeles permanecen, por lo que el fondo se puede volver a pintar en cualquier momento."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विषयों को अग्रभूमि में रखते हुए पृष्ठभूमि को लेयर मास्क के पीछे छिपाएँ। पिक्सेल बने रहते हैं, इसलिए पृष्ठभूमि को किसी भी समय वापस चित्रित किया जा सकता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cachez l'arrière-plan derrière un masque de calque, en conservant les sujets au premier plan. Les pixels restent, l'arrière-plan peut donc être repeint à tout moment."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإخفاء الخلفية خلف قناع الطبقة، مع الاحتفاظ بالموضوعات الأمامية. تبقى وحدات البكسل، بحيث يمكن إعادة رسم الخلفية في أي وقت."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculte o fundo atrás de uma máscara de camada, mantendo os assuntos do primeiro plano. Os pixels permanecem, então o fundo pode ser pintado de volta a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спрячьте фон за маской слоя, оставив объекты на переднем плане. Пиксели остаются, поэтому фон можно перекрасить в любое время."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondi lo sfondo dietro una maschera di livello, mantenendo i soggetti in primo piano. I pixel rimangono, quindi lo sfondo può essere ridipinto in qualsiasi momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーマスクの背後にある背景を非表示にし、前景の被写体を維持します。ピクセルは保持されるため、いつでも背景をペイントし直すことができます。"
          }
        }
      }
    },
