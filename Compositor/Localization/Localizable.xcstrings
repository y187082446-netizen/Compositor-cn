          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proprietà"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロパティ"
          }
        }
      }
    },
    "Protect bright areas near the edge": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保护边缘附近的明亮区域"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja las áreas brillantes cerca del borde"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किनारे के पास उज्ज्वल क्षेत्रों को सुरक्षित रखें"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protégez les zones lumineuses près du bord"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حماية المناطق الساطعة بالقرب من الحافة"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteja áreas brilhantes perto da borda"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защитите яркие области вблизи края"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteggi le aree luminose vicino al bordo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジ付近の明るい領域を保護する"
          }
        }
      }
    },
    "Protects bright pixels while a dark vignette is applied. Used by Highlight Priority.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用深色晕影的同时保护明亮像素。由突出显示优先级使用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege los píxeles brillantes mientras se aplica una viñeta oscura. Utilizado por Prioridad de resaltado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गहरे रंग का विगनेट लगाने पर चमकीले पिक्सेल की सुरक्षा करता है। हाइलाइट प्रायोरिटी द्वारा उपयोग किया जाता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protège les pixels clairs lorsqu'une vignette sombre est appliquée. Utilisé par Highlight Priority."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحمي وحدات البكسل الساطعة أثناء تطبيق نقوش الصورة النصفية الداكنة. يتم استخدامه بواسطة أولوية التمييز."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege pixels brilhantes enquanto uma vinheta escura é aplicada. Used by Highlight Priority."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищает яркие пиксели при применении темной виньетки. Используется приоритетом выделения."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Protegge i pixel luminosi mentre viene applicata una vignettatura scura. Utilizzato da Priorità evidenziazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗いビネットが適用されている間、明るいピクセルを保護します。ハイライト優先で使用されます。"
          }
        }
      }
    },
    "Proximity Match": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邻近匹配"
          }
