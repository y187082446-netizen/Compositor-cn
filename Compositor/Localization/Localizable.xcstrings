    "Make each dithered pixel this many pixels across, for a chunky old-screen look": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使每个抖动像素跨过这么多像素，以获得厚实的旧屏幕外观"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga que cada píxel difuminado tenga esta cantidad de píxeles de ancho para lograr una apariencia de pantalla antigua y gruesa"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराने स्क्रीन के मोटे लुक के लिए प्रत्येक बिखरे हुए पिक्सेल को इतने सारे पिक्सेल बनाएं"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites en sorte que chaque pixel tramé ait autant de pixels de largeur, pour un aspect vieil écran volumineux"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل كل بكسل متدرجًا هذا العدد من البكسلات، للحصول على مظهر شاشة قديمة مكتنزة"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça com que cada pixel pontilhado tenha a mesma quantidade de pixels, para uma aparência robusta de tela antiga"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте каждый размытый пиксель таким же количеством пикселей в поперечнике, чтобы получить объемный вид старого экрана."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendi ciascun pixel retinato di questo numero di pixel, per un aspetto grosso del vecchio schermo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分厚い古い画面の外観を得るには、ディザリングされた各ピクセルをこの数のピクセルにします。"
          }
        }
      }
    },
    "Make the lines waver sideways down the screen, like a CRT losing sync": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使线条在屏幕上横向摆动，就像 CRT 失去同步一样"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga que las líneas oscilen hacia los lados de la pantalla, como si un CRT perdiera sincronización."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइनों को स्क्रीन के नीचे की ओर झुकाएं, जैसे कि CRT सिंक खो रहा हो"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites vaciller les lignes latéralement sur l'écran, comme un tube cathodique perdant la synchronisation"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل الخطوط تتأرجح بشكل جانبي أسفل الشاشة، مثل فقدان مزامنة CRT"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça as linhas oscilarem lateralmente na tela, como um CRT perdendo sincronia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заставьте линии колебаться по экрану, как будто ЭЛТ теряет синхронизацию."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai oscillare le linee lateralmente lungo lo schermo, come un CRT che perde la sincronizzazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "CRT が同期を失ったように、線を画面上で横に揺らします。"
          }
        }
      }
    },
    "Makes light and dark tones more or less different, mostly around the middle.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使浅色调和暗色调或多或少有所不同，大部分在中间。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que los tonos claros y oscuros sean más o menos diferentes, principalmente alrededor del medio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हल्के और गहरे टोन को कमोबेश अलग-अलग बनाता है, ज्यादातर बीच के आसपास।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend les tons clairs et foncés plus ou moins différents, principalement autour du milieu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل النغمات الفاتحة والداكنة مختلفة إلى حد ما، معظمها حول المنتصف."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna os tons claros e escuros mais ou menos diferentes, principalmente no meio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делает светлые и темные тона более или менее разными, в основном в середине."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rende i toni chiari e scuri più o meno diversi, soprattutto nella parte centrale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主に中間あたりで、明るい色調と暗い色調を多かれ少なかれ変えます。"
          }
        }
      }
    },
    "Makes the color smoothing softer or tighter.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颜色变得更柔和或更紧致。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el color se alise más suave o más firme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रंग को मुलायम या कड़ा बनाता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend le lissage de la couleur plus doux ou plus serré."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل تنعيم اللون أكثر نعومة أو إحكامًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a suavização da cor mais suave ou mais firme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делает сглаживание цвета более мягким или плотным."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rende il livellamento del colore più morbido o più stretto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カラー スムージングをより柔らかく、またはよりタイトにします。"
          }
        }
      }
    },
    "Makes the grain coarser or finer.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使颗粒变得更粗或更细。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el grano sea más grueso o más fino."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनाज को मोटा या बारीक बनाता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend le grain plus grossier ou plus fin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل الحبوب خشنة أو أدق."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna o grão mais grosso ou mais fino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делает зерно более грубым или более мелким."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rende la grana più grossa o più fine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "粒子を粗くまたは細かくします。"
          }
        }
      }
    },
    "Makes the grain smoother or more uneven.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使纹理更光滑或更不均匀。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que la veta sea más suave o más desigual."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दाने को चिकना या अधिक असमान बनाता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend le grain plus lisse ou plus irrégulier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل الحبوب أكثر سلاسة أو أكثر تفاوتا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna o grão mais liso ou irregular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делает зерно более гладким или неровным."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rende la grana più liscia o più irregolare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "木目を滑らかにしたり、不均一にしたりします。"
          }
        }
      }
    },
    "Makes the picked color lighter or darker.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使所选颜色变浅或变深。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace que el color elegido sea más claro o más oscuro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए रंग को हल्का या गहरा बनाता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend la couleur choisie plus claire ou plus foncée."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل اللون المختار أفتح أو أغمق."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a cor escolhida mais clara ou mais escura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делает выбранный цвет светлее или темнее."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rende il colore selezionato più chiaro o più scuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色を明るくまたは暗くします。"
          }
        }
      }
    },
    "Makes the picked color stronger or quieter.": {
      "extractionState": "manual",
