    "Earliest response. Hue, saturation, and shadow tint move about half as far as Version 6.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最早的回应。色调、饱和度和阴影色调的移动幅度约为版本 6 的一半。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera respuesta. El tono, la saturación y el tinte de sombra se mueven aproximadamente a la mitad de la versión 6."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शीघ्रतम प्रतिक्रिया. संस्करण 6 की तुलना में रंग, संतृप्ति और छाया रंग लगभग आधा हो गया है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première réponse. La teinte, la saturation et la teinte des ombres évoluent environ de moitié par rapport à la version 6."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاستجابة المبكرة. تتحرك درجة اللون والتشبع ولون الظل بمقدار النصف تقريبًا حتى الإصدار 6."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resposta mais antiga. Matiz, saturação e tonalidade de sombra se movem cerca de metade da versão 6."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самый ранний ответ. Цветовой тон, насыщенность и оттенок тени изменены примерно вдвое по сравнению с версией 6."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prima risposta. Tonalità, saturazione e tinta dell'ombra si spostano di circa la metà rispetto alla versione 6."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一番早い対応。色相、彩度、および影の色合いは、バージョン 6 の約半分に移動します。"
          }
        }
      }
    },
