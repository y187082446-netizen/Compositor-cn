    "Pull the mask onto the image's own edges, which recovers hair and fur": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将蒙版拉到图像自身的边缘，以恢复头发和毛皮"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire de la máscara sobre los propios bordes de la imagen, lo que recupera el pelo y el pelaje."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मास्क को छवि के किनारों पर खींचें, जिससे बाल और फर ठीक हो जाते हैं"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirez le masque sur les bords de l'image, ce qui récupère les cheveux et la fourrure."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب القناع إلى حواف الصورة، مما يستعيد الشعر والفراء"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Puxe a máscara nas próprias bordas da imagem, o que recupera cabelos e pelos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Натяните маску на края изображения, что восстановит волосы и мех."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirare la maschera sui bordi dell'immagine, recuperando capelli e pelliccia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マスクを画像の端に引っ張り、髪と毛皮を回復します。"
          }
        }
      }
    },
    "Pulls red and blue fringes apart toward the center to reduce color edging.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将红色和蓝色边缘拉向中心以减少颜色边缘。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa los flecos rojos y azules hacia el centro para reducir los bordes de color."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रंग के किनारे को कम करने के लिए लाल और नीले किनारों को केंद्र की ओर अलग खींचता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écarte les franges rouges et bleues vers le centre pour réduire les bordures de couleur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسحب الأطراف الحمراء والزرقاء بعيدًا نحو المركز لتقليل حواف اللون."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Separa as franjas vermelhas e azuis em direção ao centro para reduzir as bordas coloridas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Раздвигает красную и синюю полосы к центру, чтобы уменьшить цветные края."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allunga le frange rosse e blu verso il centro per ridurre i bordi colorati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "赤と青のフリンジを中心に向かって引き離して、色のエッジを軽減します。"
          }
        }
      }
    },
