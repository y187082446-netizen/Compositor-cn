    "Strengthens or weakens every color by the same amount.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以相同的量增强或减弱每种颜色。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece o debilita todos los colores en la misma cantidad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक रंग को समान मात्रा में मजबूत या कमजोर करता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforce ou affaiblit chaque couleur de la même manière."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوي أو يضعف كل لون بنفس المقدار."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece ou enfraquece todas as cores na mesma proporção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Усиливает или ослабляет каждый цвет на одинаковую величину."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafforza o indebolisce tutti i colori della stessa quantità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての色を同じ量だけ強化または弱めます。"
          }
        }
      }
    },
