          "stringUnit": {
            "state": "translated",
            "value": "Как далеко достигает насыщения регулировка."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fino a che punto arriva la saturazione della regolazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調整がどこまで飽和状態に達するか。"
          }
        }
      }
    },
    "How far the blur softens, in pixels": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊柔化的程度（以像素为单位）"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta qué punto se suaviza el desenfoque, en píxeles"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "How far the blur softens, in pixels"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quelle mesure le flou s'adoucit, en pixels"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى أي مدى يخفف التمويه بالبكسل"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que ponto o desfoque é suavizado, em pixels"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько смягчается размытие, в пикселях"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto si attenua la sfocatura, in pixel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ぼかしがどの程度柔らかくなるか (ピクセル単位)"
          }
        }
      }
    },
    "How much of each pixel's error spreads to its neighbors. Less gives flatter areas": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个像素的误差有多少传播到其相邻像素。更少会产生更平坦的区域"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto del error de cada píxel se propaga a sus vecinos. Menos da áreas más planas"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक पिक्सेल की कितनी त्रुटि उसके पड़ोसियों तक फैलती है। कम समतल क्षेत्र देता है"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quelle mesure l'erreur de chaque pixel se propage à ses voisins. Moins donne des zones plus plates"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار الخطأ الذي ينتشر في كل بكسل إلى جيرانه. أقل يعطي مناطق مسطحة"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto do erro de cada pixel se espalha para seus vizinhos. Menos proporciona áreas mais planas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Какая часть ошибки каждого пикселя распространяется на его соседей. Меньше дает более плоские области"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto dell'errore di ciascun pixel si diffonde ai suoi vicini. Meno dà aree più piatte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ピクセルの誤差が隣接するピクセルにどの程度広がるか。少ないほど平坦な領域が得られます"
          }
        }
      }
    },
    "How much of the profile distortion correction is applied.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用了多少轮廓畸变校正。"
