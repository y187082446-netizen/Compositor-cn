    "Your changes will be lost if you don’t save them.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您不保存，您的更改将会丢失。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus cambios se perderán si no los guarda."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आप अपने परिवर्तन सहेज नहीं पाते हैं तो वे खो जाएंगे।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications seront perdues si vous ne les enregistrez pas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم فقدان تغييراتك إذا لم تقم بحفظها."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas alterações serão perdidas se você não salvá-las."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши изменения будут потеряны, если вы их не сохраните."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche andranno perse se non le salvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存しないと、変更は失われます。"
          }
        }
      }
    },
