    "Another app changed this project. You can revert to the version on disk, losing your unsaved changes, or keep what you have.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个应用程序改变了这个项目。您可以恢复到磁盘上的版本，丢失未保存的更改，或保留现有的内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra aplicación cambió este proyecto. Puede volver a la versión en el disco, perder los cambios no guardados o conservar la que tiene."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी अन्य ऐप ने इस प्रोजेक्ट को बदल दिया. आप डिस्क पर संस्करण पर वापस लौट सकते हैं, अपने सहेजे न गए परिवर्तन खो सकते हैं, या जो आपके पास है उसे रख सकते हैं।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre application a modifié ce projet. Vous pouvez revenir à la version sur le disque, en perdant vos modifications non enregistrées, ou conserver ce que vous avez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطبيق آخر غيّر هذا المشروع. يمكنك العودة إلى الإصدار الموجود على القرص، أو فقدان التغييرات غير المحفوظة، أو الاحتفاظ بما لديك."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro aplicativo mudou este projeto. Você pode reverter para a versão em disco, perdendo as alterações não salvas, ou manter o que possui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое приложение изменило этот проект. Вы можете вернуться к версии на диске, потеряв несохраненные изменения, или сохранить то, что у вас есть."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra app ha cambiato questo progetto. Puoi ripristinare la versione su disco, perdendo le modifiche non salvate o mantenere ciò che hai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリがこのプロジェクトを変更しました。ディスク上のバージョンに戻して、保存されていない変更を失うことも、既存の変更を保持することもできます。"
          }
        }
      }
    },
