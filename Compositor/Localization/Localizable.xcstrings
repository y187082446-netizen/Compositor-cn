    "Tones from black on the left to white on the right: blacks, shadows, midtones, highlights, whites. Control-click to show the vectorscope.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色调从左边的黑色到右边的白色：黑色、阴影、中间调、高光、白色。按住 Control 键单击以显示矢量示波器。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tonos del negro a la izquierda al blanco a la derecha: negros, sombras, medios tonos, luces, blancos. Mantenga presionada la tecla Control y haga clic para mostrar el vectorscopio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाईं ओर काले से दाईं ओर सफेद तक टोन: काला, छाया, मिडटोन, हाइलाइट्स, सफेद। वेक्टरस्कोप दिखाने के लिए कंट्रोल-क्लिक करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tons du noir à gauche au blanc à droite : noirs, ombres, tons moyens, reflets, blancs. Contrôle-clic pour afficher le vecteurscope."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "درجات الألوان من الأسود على اليسار إلى الأبيض على اليمين: الأسود والظلال والدرجات اللونية النصفية والإبرازات والأبيض. انقر مع الضغط على مفتاح التحكم لإظهار نطاق المتجهات."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tons do preto à esquerda ao branco à direita: pretos, sombras, meios-tons, realces, brancos. Clique com a tecla Control pressionada para mostrar o vetorscópio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тона от черного слева до белого справа: черный, тени, средние тона, светлые тона, белый. Удерживая клавишу Control, щелкните, чтобы отобразить вектороскоп."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toni dal nero a sinistra al bianco a destra: neri, ombre, mezzitoni, luci, bianchi. Fai clic tenendo premuto il tasto Control per mostrare il vettorscopio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の黒から右の白までのトーン: 黒、シャドウ、ミッドトーン、ハイライト、白。 Control キーを押しながらクリックすると、ベクトルスコープが表示されます。"
          }
        }
      }
    },
    "Tones per channel: 2 is pure black and white": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每通道音调：2种为纯黑白"
          }
        },
        "es": {
