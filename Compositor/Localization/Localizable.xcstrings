    "Drag a color in the picture. Nearby color families move together.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图片中拖动一种颜色。邻近的色系会一起移动。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un color en la imagen. Las familias de colores cercanas se mueven juntas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चित्र में कोई रंग खींचें. आस-पास के रंग परिवार एक साथ चलते हैं।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une couleur dans l'image. Les familles de couleurs voisines se déplacent ensemble."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لونًا في الصورة. تتحرك عائلات الألوان القريبة معًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma cor na imagem. As famílias de cores próximas movem-se juntas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите цвет на картинке. Близлежащие цветные семьи движутся вместе."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un colore nell'immagine. Le famiglie di colore vicine si muovono insieme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像内の色をドラッグします。近くの色の家族は一緒に移動します。"
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动一个点。单击以添加一个。双击一个点将其删除。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra un punto. Haga clic para agregar uno. Haga doble clic en un punto para eliminarlo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बिंदु खींचें. एक जोड़ने के लिए क्लिक करें. किसी बिंदु को हटाने के लिए उस पर डबल-क्लिक करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un point. Cliquez pour en ajouter un. Double-cliquez sur un point pour le supprimer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب نقطة. انقر لإضافة واحدة. انقر نقرًا مزدوجًا فوق نقطة لإزالتها."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste um ponto. Clique para adicionar um. Clique duas vezes em um ponto para removê-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите точку. Нажмите, чтобы добавить его. Дважды щелкните точку, чтобы удалить ее."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un punto. Fare clic per aggiungerne uno. Fare doppio clic su un punto per rimuoverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "点をドラッグします。クリックして追加します。ポイントをダブルクリックして削除します。"
          }
        }
      }
    },
    "Drag a rectangle · Shift add · Option subtract · Shift again mid-drag square · Drag inside to move · ⌘-drag moves pixels · Delete clears · ⌘D deselect": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动矩形 · Shift 添加 · Option 减去 · 再次 Shift 中间拖动正方形 · 向内拖动以移动 · ⌘-拖动移动像素 · 删除清除 · ⌘D 取消选择"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un rectángulo · Mayús agregar · Opción restar · Mayús nuevamente mientras arrastra el cuadrado · Arrastre hacia adentro para mover · ⌘-arrastrar mueve píxeles · Eliminar borra · ⌘D deseleccionar"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक आयत खींचें · शिफ्ट जोड़ें · विकल्प घटाएं · फिर से मध्य-खींचें वर्ग को शिफ्ट करें · स्थानांतरित करने के लिए अंदर खींचें · ⌘-खींचें पिक्सेल को स्थानांतरित करता है · हटाएं साफ़ करें · ⌘D अचयनित करें"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un rectangle · Maj ajouter · Option soustraire · Décaler à nouveau au milieu du carré · Faire glisser à l'intérieur pour déplacer · ⌘-glisser déplace les pixels · Supprimer efface · ⌘D désélectionner"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب مستطيلًا · Shift add · Option subtract · Shift مرة أخرى في منتصف مربع السحب · اسحب للداخل للتحرك · ⌘ - اسحب وحدات البكسل · حذف للمسح · ⌘D قم بإلغاء التحديد"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastar um retângulo · Shift adicionar · Opção subtrair · Shift novamente no meio do arrasto do quadrado · Arraste para dentro para mover · ⌘-arraste move pixels · Excluir limpa · ⌘D desmarcar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащить прямоугольник · Shift добавить · Опция вычесть · Снова сдвинуть квадрат в середине перетаскивания · Перетащить внутрь для перемещения · Перетаскивание с нажатой клавишей ⌘ перемещает пиксели · Удалить очищает · ⌘D отменить выбор"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un rettangolo · Maiusc aggiungi · Opzione sottrai · Maiusc di nuovo trascina il quadrato a metà · Trascina all'interno per spostare · ⌘-trascina sposta i pixel · Elimina cancella · ⌘D deseleziona"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長方形をドラッグ · Shift で追加 · Option で減算 · 正方形をドラッグ中にもう一度 Shift · 内側にドラッグして移動 · ⌘ キーを押しながらドラッグでピクセルを移動 · 削除で消去 · ⌘D で選択を解除"
          }
        }
      }
    },
    "Drag a text box · Click text to edit · Drag box handles to resize · ⌘Return finish · Escape cancel": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动文本框 · 单击文本进行编辑 · 拖动框手柄以调整大小 · ⌘返回完成 · 退出取消"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre un cuadro de texto · Haga clic en el texto para editarlo · Arrastre los controles del cuadro para cambiar el tamaño · ⌘Volver a finalizar · Escape cancelar"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट बॉक्स खींचें · संपादित करने के लिए टेक्स्ट पर क्लिक करें · आकार बदलने के लिए बॉक्स हैंडल खींचें · ⌘वापसी समाप्त करें · एस्केप रद्द करें"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
