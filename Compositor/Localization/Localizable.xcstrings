    "Paint with the foreground color (B), or erase pixels away (E)": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用前景色绘制 (B)，或擦除像素 (E)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinte con el color de primer plano (B) o borre píxeles (E)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अग्रभूमि रंग से पेंट करें (बी), या पिक्सेल मिटा दें (ई)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peignez avec la couleur de premier plan (B) ou effacez les pixels (E)"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطلاء باللون الأمامي (B)، أو مسح وحدات البكسل (E)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinte com a cor do primeiro plano (B) ou apague os pixels (E)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрасьте цветом переднего плана (B) или сотрите пиксели (E)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipingi con il colore di primo piano (B) o cancella i pixel (E)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前景色でペイントするか (B)、ピクセルを消去します (E)"
          }
        }
      }
