    "Click the original layer to set %@. Click the eyedropper again to stop.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击原始图层以设置%@。再次单击吸管即可停止。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haga clic en la capa original para establecer %@. Haga clic en el cuentagotas nuevamente para detenerse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सेट करने के लिए मूल परत पर क्लिक करें। रोकने के लिए आईड्रॉपर पर फिर से क्लिक करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur le calque d'origine pour définir %@. Cliquez à nouveau sur la pipette pour arrêter."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر فوق الطبقة الأصلية لتعيين %@. انقر فوق الشافطة مرة أخرى للتوقف."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique na camada original para definir %@. Clique no conta-gotas novamente para parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щелкните исходный слой, чтобы установить %@. Нажмите пипетку еще раз, чтобы остановить."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare clic sul livello originale per impostare %@. Fare di nuovo clic sul contagocce per interrompere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のレイヤーをクリックして %@ を設定します。停止するには、スポイトをもう一度クリックします。"
          }
        }
      }
    },
