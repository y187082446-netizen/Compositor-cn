    "Parametric lifts tonal regions. Point places anchors on the curve.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参数提升色调区域。 Point 将锚点放置在曲线上。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elevaciones paramétricas de regiones tonales. El punto coloca anclajes en la curva."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैरामीट्रिक टोनल क्षेत्रों को उठाता है। बिंदु वक्र पर लंगर डालता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les régions tonales liftées paramétriques. Le point place des ancres sur la courbe."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بارامترية ترفع المناطق النغمية. تضع النقطة نقاط ارتكاز على المنحنى."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramétrico eleva regiões tonais. Point coloca âncoras na curva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметрическое улучшение тональных областей. Точка размещает якоря на кривой."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascensori parametrici delle regioni tonali. Il punto posiziona gli ancoraggi sulla curva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パラメトリックな階調領域のリフト。ポイントはカーブ上にアンカーを配置します。"
          }
        }
      }
    },
