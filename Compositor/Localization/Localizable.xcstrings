    "Perspective allows stronger keystone. Rectilinear keeps the warp gentler.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "透视允许更强的梯形校正。直线使经纱更加柔和。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La perspectiva permite una piedra angular más fuerte. Rectilíneo mantiene la deformación más suave."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिप्रेक्ष्य मजबूत कीस्टोन की अनुमति देता है। रेक्टिलिनियर ताना को नरम रखता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La perspective permet une clé de voûte plus forte. Rectiligne maintient la chaîne plus douce."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح المنظور بحجر أساس أقوى. يحافظ الخط المستقيم على السداة أكثر لطفاً."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A perspectiva permite uma keystone mais forte. Retilíneo mantém a urdidura mais suave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перспектива обеспечивает более сильный краеугольный камень. Прямолинейный вариант сохраняет основу мягче."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prospettiva consente una chiave di volta più forte. Rettilineo mantiene l'ordito più dolce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠近法により、より強力なキーストーンが可能になります。 Rectilinear は反りをより緩やかに保ちます。"
          }
        }
      }
    },
    "Pin Light": {
