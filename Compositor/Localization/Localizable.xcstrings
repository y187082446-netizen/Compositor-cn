    "Sets how far the glow reaches. Has no effect until Glow is raised.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置发光到达的距离。在光辉升起之前没有任何效果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece hasta dónde llega el brillo. No tiene ningún efecto hasta que se aumenta el resplandor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेट करता है कि चमक कितनी दूर तक पहुँचती है। जब तक चमक नहीं बढ़ती तब तक कोई प्रभाव नहीं पड़ता।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit la portée de la lueur. N'a aucun effet jusqu'à ce que Glow soit augmenté."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط المدى الذي يصل إليه التوهج. ليس له أي تأثير حتى يتم رفع الوهج."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define até onde o brilho alcança. Não tem efeito até que o brilho seja aumentado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает, как далеко распространяется свечение. Не имеет эффекта, пока свечение не поднято."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la distanza raggiunta dal bagliore. Non ha effetto finché Glow non viene attivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローがどこまで届くかを設定します。 Glowが上がるまで効果はありません。"
          }
        }
      }
    },
    "Sets the brightest point. Hold Option to see clipped highlights.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置最亮点。按住 Option 可查看剪切的高光。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece el punto más brillante. Mantenga presionada la opción para ver los aspectos más destacados recortados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे चमकीला बिंदु सेट करता है. क्लिप किए गए हाइलाइट्स देखने के लिए विकल्प दबाए रखें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le point le plus lumineux. Maintenez Option pour voir les faits saillants coupés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط ألمع نقطة. اضغط مع الاستمرار على الخيار لرؤية النقاط البارزة المقطوعة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o ponto mais brilhante. Segure Opção para ver os destaques cortados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает самую яркую точку. Удерживайте Option, чтобы увидеть обрезанные блики."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il punto più luminoso. Tieni premuto Opzione per vedere le luci ritagliate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も明るい点を設定します。 Option を押し続けると、クリップされたハイライトが表示されます。"
          }
        }
      }
    },
    "Sets the darkest point. Hold Option to see clipped shadows.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置最暗点。按住 Option 可查看剪切的阴影。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece el punto más oscuro. Mantenga presionada la opción para ver las sombras recortadas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे अंधकारमय बिंदु सेट करता है. कटी हुई छाया देखने के लिए विकल्प दबाए रखें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit le point le plus sombre. Maintenez Option pour voir les ombres coupées."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد أحلك نقطة. اضغط مع الاستمرار على الخيار لرؤية الظلال المقطوعة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define o ponto mais escuro. Segure Option para ver sombras cortadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает самую темную точку. Удерживайте Option, чтобы увидеть обрезанные тени."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the darkest point. Tieni premuto Opzione per vedere le ombre ritagliate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も暗い点を設定します。 Option を押し続けると、クリップされた影が表示されます。"
          }
        }
      }
    },
    "Sets where the vignette begins, from the center outward.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置晕影开始的位置，从中心向外。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece dónde comienza la viñeta, desde el centro hacia afuera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेट करता है जहां से विग्नेट शुरू होता है, केंद्र से बाहर की ओर।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit l'endroit où commence la vignette, du centre vers l'extérieur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد المكان الذي تبدأ فيه الصورة النصفية، من المركز إلى الخارج."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define onde a vinheta começa, do centro para fora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает начало виньетки — от центра наружу."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta il punto in cui inizia la vignetta, dal centro verso l'esterno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビネットの開始位置を中心から外側に設定します。"
          }
        }
      }
    },
    "Several layers are selected. Select just one to paint on it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择了几个层。仅选择一个在其上绘画。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se seleccionan varias capas. Selecciona solo uno para pintar sobre él."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई परतों का चयन किया जाता है. इस पर पेंट करने के लिए केवल एक का चयन करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs calques sont sélectionnés. Sélectionnez-en un seul pour peindre dessus."
          }
