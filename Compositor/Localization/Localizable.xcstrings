    "Darkens or lightens the edges. The center does not change.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使边缘变暗或变亮。中心不变。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscurece o aclara los bordes. El centro no cambia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किनारों को गहरा या हल्का कर देता है। केंद्र नहीं बदलता."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit ou éclaircit les bords. Le centre ne change pas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغمق أو يخفف الحواف. المركز لا يتغير."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece ou clareia as bordas. O centro não muda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемняет или осветляет края. Центр не меняется."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scurisce o schiarisce i bordi. Il centro non cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エッジを暗くしたり明るくしたりします。中心は変わらない。"
          }
        }
      }
    },
