    "Strengthens quiet colors more than colors that are already strong, and protects skin tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比本来就很浓的颜色更强化安静的颜色，并保护肤色。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece los colores tranquilos más que los colores que ya son fuertes y protege los tonos de la piel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले से ही मजबूत रंगों की तुलना में शांत रंगों को अधिक मजबूत करता है, और त्वचा के रंग की रक्षा करता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renforce les couleurs calmes plus que les couleurs déjà fortes et protège les tons chair."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوي الألوان الهادئة أكثر من الألوان القوية بالفعل، ويحمي لون البشرة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortalece mais as cores calmas do que as já fortes e protege os tons de pele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Усиливает спокойные цвета больше, чем уже яркие, и защищает оттенки кожи."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafforza i colori tenui più dei colori già forti e protegge le tonalità della pelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元々強い色よりも静かな色を強め、肌色を守ります。"
          }
        }
      }
    },
    "Stretches width relative to height.": {
