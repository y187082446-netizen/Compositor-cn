    "Some dropped items couldn’t be read. Drag JPEG, PNG, HEIC, TIFF, or Photoshop (PSD) files from Finder.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一些掉落的物品无法读取。从 Finder 中拖动 JPEG、PNG、HEIC、TIFF 或 Photoshop (PSD) 文件。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos elementos caídos no se pudieron leer. Arrastre archivos JPEG, PNG, HEIC, TIFF o Photoshop (PSD) desde Finder."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ गिराए गए आइटम पढ़े नहीं जा सके. फाइंडर से JPEG, PNG, HEIC, TIFF, या Photoshop (PSD) फ़ाइलें खींचें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains éléments supprimés n'ont pas pu être lus. Faites glisser les fichiers JPEG, PNG, HEIC, TIFF ou Photoshop (PSD) depuis le Finder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن قراءة بعض العناصر المسقطة. اسحب ملفات JPEG، أو PNG، أو HEIC، أو TIFF، أو Photoshop (PSD) من Finder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Some dropped items couldn’t be read. Arraste arquivos JPEG, PNG, HEIC, TIFF ou Photoshop (PSD) do Finder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые выпавшие предметы невозможно было прочитать. Перетащите файлы JPEG, PNG, HEIC, TIFF или Photoshop (PSD) из Finder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere alcuni elementi rilasciati. Trascina file JPEG, PNG, HEIC, TIFF o Photoshop (PSD) dal Finder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のドロップアイテムは読み取れませんでした。 JPEG、PNG、HEIC、TIFF、または Photoshop (PSD) ファイルを Finder からドラッグします。"
