    "Cropped to the canvas so the file fits in memory. Pixels outside the canvas weren't imported.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裁剪到画布，以便文件适合内存。画布外部的像素未导入。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recortado en el lienzo para que el archivo quepa en la memoria. Los píxeles fuera del lienzo no se importaron."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैनवास पर क्रॉप किया गया ताकि फ़ाइल मेमोरी में फ़िट हो जाए। कैनवास के बाहर के पिक्सेल आयात नहीं किए गए थे."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recadré sur le canevas pour que le fichier tienne en mémoire. Les pixels en dehors du canevas n’ont pas été importés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم اقتصاصه على اللوحة القماشية بحيث يتناسب الملف مع الذاكرة. لم يتم استيراد وحدات البكسل الموجودة خارج اللوحة القماشية."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cortado na tela para que o arquivo caiba na memória. Pixels fora da tela não foram importados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезано до холста, чтобы файл поместился в памяти. Пиксели за пределами холста не импортировались."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritagliato sulla tela in modo che il file si adatti alla memoria. I pixel esterni all'area di disegno non sono stati importati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルがメモリに収まるようにキャンバスにトリミングされます。キャンバスの外側のピクセルはインポートされませんでした。"
          }
        }
      }
    },
    "Crops empty edges after the transform and fits the result back into the frame.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "变换后裁剪空边缘并将结果放回框架中。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorta los bordes vacíos después de la transformación y ajusta el resultado nuevamente en el marco."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवर्तन के बाद खाली किनारों को काटता है और परिणाम को वापस फ्रेम में फिट करता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recadre les bords vides après la transformation et réinsère le résultat dans le cadre."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم بقص الحواف الفارغة بعد التحويل ويلائم النتيجة مرة أخرى في الإطار."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta bordas vazias após a transformação e ajusta o resultado de volta ao quadro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезает пустые края после преобразования и помещает результат обратно в кадр."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritaglia i bordi vuoti dopo la trasformazione e reinserisce il risultato nella cornice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換後に空のエッジをトリミングし、結果をフレームに戻します。"
          }
        }
      }
    },
    "Current default. The calibration sliders below apply at full strength.": {
