    "Layer effects were discarded, so the appearance may differ.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图层效果已被丢弃，因此外观可能有所不同。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartaron los efectos de capa, por lo que la apariencia puede diferir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परत प्रभाव हटा दिए गए, इसलिए स्वरूप भिन्न हो सकता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les effets de calque ont été supprimés, l'apparence peut donc différer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تجاهل تأثيرات الطبقة، لذلك قد يختلف المظهر."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os efeitos de camada foram descartados, portanto a aparência pode ser diferente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эффекты слоев были удалены, поэтому внешний вид может отличаться."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli effetti dei livelli sono stati eliminati, quindi l'aspetto potrebbe differire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤー効果は破棄されているため、見た目が異なる場合があります。"
          }
        }
      }
    },
