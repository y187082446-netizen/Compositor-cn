    "Click to zoom in · Option-click to zoom out · Drag right or left to zoom smoothly · Space to pan": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单击可放大 · 按住 Option 键单击可缩小 · 向右或向左拖动可平滑缩放 · 空格键可平移"
          }
        },
        "es": {
