    "Clipping mask based on %@. Option-click the bottom of its row to release.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 %@ 的剪切蒙版。按住 Option 键单击该行的底部以释放。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Máscara de recorte basada en %@. Opción-haga clic en la parte inferior de su fila para liberarla."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर आधारित क्लिपिंग मास्क। रिलीज़ करने के लिए इसकी पंक्ति के निचले भाग पर विकल्प-क्लिक करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque d'écrêtage basé sur %@. Option-cliquez sur le bas de sa ligne pour la libérer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قناع القطع يعتمد على %@. انقر مع الضغط على مفتاح الاختيار أسفل الصف الخاص به لتحريره."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Máscara de recorte baseada em %@. Clique com a tecla Option pressionada na parte inferior de sua linha para liberar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обтравочная маска на основе %@. Удерживая клавишу Option, щелкните нижнюю часть строки, чтобы отпустить ее."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Maschera di ritaglio basata su %@. Fai clic tenendo premuto il tasto Opzione sulla parte inferiore della riga per rilasciarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に基づくクリッピング マスク。 Option キーを押しながらその行の一番下をクリックして解放します。"
