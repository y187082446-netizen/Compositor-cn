    "Basic is quick; Advanced refines the mask against the layer's own detail, for hair and fur": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基本很快；高级根据图层自身的细节（头发和毛皮）细化蒙版"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo básico es rápido; Avanzado refina la máscara contra el propio detalle de la capa, para cabello y pelaje."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेसिक त्वरित है; एडवांस्ड बालों और फर के लिए, परत के अपने विवरण के अनुसार मास्क को परिष्कृत करता है"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le basique est rapide ; Advanced affine le masque selon les détails de la couche, pour les cheveux et la fourrure"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأساسية سريعة؛ يقوم Advanced بتنقية القناع وفقًا لتفاصيل الطبقة نفسها، للشعر والفراء"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Básico é rápido; Advanced refina a máscara contra os próprios detalhes da camada, para cabelos e pelos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базовый — быстрый; Расширенный уточняет маску по деталям слоя, для волос и меха."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di base è veloce; Advanced rifinisce la maschera rispetto ai dettagli dello strato, per capelli e pelliccia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本は速いです。 Advanced では、ヘアとファーのレイヤー独自のディテールに対してマスクを調整します。"
          }
        }
      }
    },
