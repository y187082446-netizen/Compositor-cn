    "Drag to set hue and saturation. Double-click to reset this wheel.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以设置色调和饱和度。双击可重置该轮子。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastre para establecer el tono y la saturación. Haga doble clic para restablecer esta rueda."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रंग और संतृप्ति सेट करने के लिए खींचें। इस पहिये को रीसेट करने के लिए डबल-क्लिक करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour définir la teinte et la saturation. Double-cliquez pour réinitialiser cette roue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لضبط اللون والتشبع. انقر نقرًا مزدوجًا لإعادة ضبط هذه العجلة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para definir o matiz e a saturação. Clique duas vezes para redefinir esta roda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы установить оттенок и насыщенность. Дважды щелкните, чтобы сбросить это колесо."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per impostare tonalità e saturazione. Fare doppio clic per reimpostare questa ruota."
          }
        },
        "ja": {
