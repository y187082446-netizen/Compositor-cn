            "value": "显示变换框和手柄 (⌘H)。隐藏后，拖动任意位置即可移动图层。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestre el cuadro de transformación y los controladores (⌘H). Cuando esté oculta, arrastre a cualquier lugar para mover la capa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रांसफ़ॉर्म बॉक्स और हैंडल (⌘H) दिखाएँ। छिपाए जाने पर, परत को स्थानांतरित करने के लिए कहीं भी खींचें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez la boîte de transformation et les poignées (⌘H). Lorsqu'il est masqué, faites glisser n'importe où pour déplacer le calque."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار مربع التحويل والمقابض (⌘H). عندما تكون مخفية، اسحب إلى أي مكان لتحريك الطبقة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre a caixa de transformação e as alças (⌘H). Quando oculto, arraste para qualquer lugar para mover a camada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите рамку преобразования и маркеры (⌘H). Когда слой скрыт, перетащите его в любое место, чтобы переместить слой."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la casella di trasformazione e le maniglie (⌘H). Quando è nascosto, trascina ovunque per spostare il livello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変換ボックスとハンドル (⌘H) を表示します。非表示の場合は、任意の場所にドラッグしてレイヤーを移動します。"
          }
        }
      }
    },
