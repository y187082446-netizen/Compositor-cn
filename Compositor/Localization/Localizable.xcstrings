    "Use 1–%@ pixels per side, up to %@ megapixels, and 1–9,600 pixels/inch.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每边使用 1–%@ 像素，最多 %@ 百万像素，以及 1–9,600 像素/英寸。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice entre 1 y %@ píxeles por lado, hasta %@ megapíxeles y entre 1 y 9600 píxeles por pulgada."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति पक्ष 1–%@ पिक्सेल, %@ मेगापिक्सेल तक, और 1–9,600 पिक्सेल/इंच का उपयोग करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez 1 à %@ pixels par côté, jusqu'à %@ mégapixels et 1 à 9 600 pixels/pouce."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم 1–%@ بكسل لكل جانب، وما يصل إلى %@ ميجابكسل، و1–9600 بكسل/بوصة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 1–%@ pixels por lado, até %@ megapixels e 1–9.600 pixels/polegada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте 1–%@ пикселей на каждую сторону, до %@ мегапикселей и 1–9600 пикселей/дюйм."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza 1–%@ pixel per lato, fino a %@ megapixel e 1–9.600 pixel/pollice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "片側あたり 1 ～ %@ ピクセル、最大 %@ メガピクセル、1 ～ 9,600 ピクセル/インチを使用します。"
          }
        }
      }
    },
    "Use gridlines every %@–%@ pixels and %@–%@ subdivisions, no more than the pixels between gridlines.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每隔 %@–%@ 像素和 %@–%@ 细分使用网格线，不超过网格线之间的像素。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice líneas de cuadrícula cada %@–%@ píxeles y %@–%@ subdivisiones, no más que los píxeles entre líneas de cuadrícula."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक %@–%@ पिक्सेल और %@–%@ उपविभाजन में ग्रिडलाइन का उपयोग करें, ग्रिडलाइन के बीच के पिक्सेल से अधिक नहीं।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un quadrillage tous les %@–%@ pixels et %@–%@ subdivisions, pas plus que les pixels entre les quadrillages."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم خطوط الشبكة في كل %@–%@ بكسل و%@–%@ تقسيمات فرعية، وليس أكثر من وحدات البكسل الموجودة بين خطوط الشبكة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use linhas de grade a cada %@–%@ pixels e subdivisões %@–%@, não mais do que os pixels entre as linhas de grade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте линии сетки каждые %@–%@ пикселей и %@–%@ подразделений, не более, чем пиксели между линиями сетки."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza le griglie ogni %@–%@ pixel e %@–%@ suddivisioni, non più dei pixel tra le griglie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@–%@ ピクセルごとにグリッド線を使用し、グリッド線の間のピクセルを超えない範囲で %@–%@ サブディビジョンを使用します。"
          }
        }
      }
    },
