    "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高光优先保护明亮的边缘。颜色优先也会减少颜色。油漆覆盖均匀地覆盖边缘。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioridad de resaltado protege los bordes brillantes. Prioridad de color también reduce el color. Paint Overlay cubre los bordes de manera uniforme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Highlight Priority protects bright edges. Color Priority also reduces color. Paint Overlay covers the edges evenly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La priorité aux hautes lumières protège les bords clairs. La priorité couleur réduit également la couleur. La superposition de peinture couvre les bords uniformément."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل خاصية Highlight Priority على حماية الحواف الساطعة. تعمل أولوية اللون أيضًا على تقليل اللون. يغطي Paint Overlay الحواف بالتساوي."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A prioridade de destaque protege bordas brilhantes. A Prioridade de Cor também reduz a cor. A sobreposição de tinta cobre as bordas uniformemente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приоритет подсветки защищает яркие края. Приоритет цвета также уменьшает цвет. Paint Overlay равномерно покрывает края."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La priorità alle alte luci protegge i bordi luminosi. Anche la Priorità colore riduce il colore. Paint Overlay copre i bordi in modo uniforme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハイライト優先は明るいエッジを保護します。カラー優先では色も軽減されます。ペイント オーバーレイはエッジを均等にカバーします。"
          }
        }
      }
    },
