    "Hue shifts the color, Saturation its strength, and Luminance its brightness.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色调改变颜色，饱和度改变强度，亮度改变亮度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tono cambia el color, Saturación su intensidad y Luminancia su brillo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रंग रंग बदलता है, संतृप्ति अपनी ताकत, और चमक अपनी चमक बदलती है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La teinte modifie la couleur, la saturation sa force et la luminance sa luminosité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم Hue بتغيير اللون، والتشبع قوته، والنصوع سطوعه."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Matiz muda a cor, Saturação sua força e Luminância seu brilho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оттенок меняет цвет, Насыщенность — силу, а Яркость — яркость."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tonalità modifica il colore, la saturazione la sua intensità e la luminanza la sua luminosità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色相は色を変化させ、彩度はその強さを変化させ、ルミナンスは明るさを変化させます。"
          }
        }
      }
    },
