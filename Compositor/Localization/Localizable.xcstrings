    "Lock aspect ratio. Hold Shift while dragging a handle to turn it the other way.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定纵横比。按住 Shift 键的同时拖动手柄可将其转向另一个方向。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear relación de aspecto. Mantenga presionada la tecla Mayús mientras arrastra un controlador para girarlo hacia el otro lado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहलू अनुपात लॉक करें. किसी हैंडल को दूसरी ओर मोड़ने के लिए उसे खींचते समय Shift दबाए रखें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller le rapport hauteur/largeur. Maintenez Shift tout en faisant glisser une poignée pour la tourner dans l’autre sens."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل نسبة العرض إلى الارتفاع. اضغط مع الاستمرار على Shift أثناء سحب المقبض لقلبه في الاتجاه الآخر."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear proporção de aspecto. Segure Shift enquanto arrasta uma alça para girá-la para o outro lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка соотношения сторон. Удерживайте Shift, перетаскивая ручку, чтобы повернуть ее в другую сторону."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca le proporzioni. Tieni premuto Maiusc mentre trascini una maniglia per girarla dall'altra parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アスペクト比をロックします。 Shift キーを押したままハンドルをドラッグすると、反対方向に回転します。"
          }
        }
      }
    },
