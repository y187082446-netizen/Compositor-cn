    "Round the rectangle's corners by this many pixels; 0 keeps them square": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将矩形的角圆化这么多像素； 0 使它们保持正方形"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redondea las esquinas del rectángulo con esta cantidad de píxeles; 0 los mantiene cuadrados"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयत के कोनों को इतने पिक्सेल से गोल करें; 0 उन्हें वर्गाकार रखता है"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrondissez les coins du rectangle de ce nombre de pixels ; 0 les garde carrés"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتدوير زوايا المستطيل بهذا العدد من البيكسلات؛ 0 يبقيهم مربعين"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arredonde os cantos do retângulo com essa quantidade de pixels; 0 os mantém quadrados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скруглите углы прямоугольника на указанное количество пикселей; 0 сохраняет их квадратными"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrotondare gli angoli del rettangolo di questo numero di pixel; 0 li mantiene quadrati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このピクセル数だけ長方形の角を丸めます。 0 は正方形を保ちます"
          }
        }
      }
    },
