        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रोजेक्ट समर्थित कैनवास, परत, फ़ाइल-आकार, या %@-मेगापिक्सेल दस्तावेज़ सीमा से अधिक है।"
          }
