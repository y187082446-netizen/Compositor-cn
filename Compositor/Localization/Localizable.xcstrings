    "Compositor will convert these Photoshop features. Nothing is applied until you continue.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Compositor 将转换这些 Photoshop 功能。在您继续之前，不会应用任何内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compositor convertirá estas funciones de Photoshop. No se aplica nada hasta que continúes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंपोजिटर इन फ़ोटोशॉप सुविधाओं को परिवर्तित कर देगा। जब तक आप जारी नहीं रखते तब तक कुछ भी लागू नहीं होता।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compositor convertira ces fonctionnalités de Photoshop. Rien n'est appliqué jusqu'à ce que vous continuiez."
          }
