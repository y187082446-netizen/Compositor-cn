    "Clear the haze that leaves background showing through thin areas": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除薄雾，使背景透过薄薄的区域显现出来"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la neblina que deja el fondo visible a través de áreas delgadas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Clear the haze that leaves background showing through thin areas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez la brume qui laisse apparaître l'arrière-plan à travers des zones fines"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإزالة الضباب الذي يترك الخلفية تظهر من خلال مناطق رقيقة"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpe a névoa que deixa o fundo aparecendo em áreas finas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устраните дымку, из-за которой фон просвечивает сквозь тонкие области."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la foschia che lascia visibile lo sfondo attraverso aree sottili"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景が薄い領域に透けて見えるかすみを除去します。"
          }
        }
      }
    },
    "Clears haze when raised, and adds haze when lowered.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起时清除雾气，降低时增加雾气。"
          }
        },
        "es": {
          "stringUnit": {
