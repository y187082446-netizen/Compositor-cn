    "Three-Way shows shadows, midtones, and highlights. The other choices show one wheel.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "三向显示阴影、中间色调和高光。其他选项显示一个轮子。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Three-Way muestra sombras, medios tonos y luces. Las otras opciones muestran una rueda."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थ्री-वे छाया, मध्य स्वर और हाइलाइट दिखाता है। अन्य विकल्प एक पहिया दिखाते हैं।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trois voies affiche les ombres, les tons moyens et les hautes lumières. Les autres choix montrent une roue."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض برنامج Three-Way الظلال والدرجات اللونية النصفية والإبرازات. تظهر الخيارات الأخرى عجلة واحدة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Three-Way mostra sombras, meios-tons e realces. As outras opções mostram uma roda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трехстороннее отображение теней, средних тонов и светлых участков. Другие варианты показывают одно колесо."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità a tre mostra ombre, mezzitoni e luci. Le altre scelte mostrano una ruota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3 ウェイでは、シャドウ、ミッドトーン、ハイライトが表示されます。他の選択肢では 1 つのホイールが表示されます。"
          }
        }
      }
    },
