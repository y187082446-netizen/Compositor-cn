        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué cantidad de corrección de distorsión del perfil se aplica."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल विरूपण सुधार का कितना भाग लागू किया गया है."
          }
        },
        "fr": {
