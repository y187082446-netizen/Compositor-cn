    "HSL lists every color. Color edits one family. Point Color adjusts a color you pick.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL 列出了每种颜色。色彩编辑一个家庭。点颜色调整您选择的颜色。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL enumera todos los colores. El color edita una familia. Point Color ajusta el color que elijas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एचएसएल हर रंग को सूचीबद्ध करता है। रंग एक परिवार को संपादित करता है। प्वाइंट कलर आपके द्वारा चुने गए रंग को समायोजित करता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL répertorie toutes les couleurs. La couleur modifie une famille. Couleur du point ajuste une couleur que vous choisissez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسرد HSL كل لون. اللون يحرر عائلة واحدة. يقوم Point Color بضبط اللون الذي تختاره."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL lista todas as cores. A cor edita uma família. Point Color ajusta a cor escolhida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL перечисляет все цвета. Цвет редактирует одно семейство. Цвет точки регулирует выбранный вами цвет."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL elenca tutti i colori. Il colore modifica una famiglia. Colore punto regola il colore scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HSL にはすべての色がリストされています。カラーは 1 つのファミリーを編集します。ポイントカラーは、選択した色を調整します。"
          }
        }
      }
    },
