    "Shift-click adds a color, Option-click takes one away.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住 Shift 键单击可添加一种颜色，按住 Option 键单击可取消一种颜色。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-clic agrega un color, Opción-clic elimina uno."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शिफ़्ट-क्लिक एक रंग जोड़ता है, विकल्प-क्लिक एक रंग हटा देता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maj-clic ajoute une couleur, Option-clic en supprime une."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف النقر مع الضغط على Shift لونًا، بينما يؤدي النقر مع الضغط على مفتاح Option إلى إزالة لون واحد."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift-clique adiciona uma cor, Option-clique remove uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щелчок с нажатой клавишей Shift добавляет цвет, щелчок с нажатой клавишей Option убирает его."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fare clic tenendo premuto Maiusc per aggiungere un colore, fare clic tenendo premuto Opzione per toglierne uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Shift キーを押しながらクリックすると色が追加され、Option キーを押しながらクリックすると色が削除されます。"
          }
        }
      }
    },
    "Shifts how blue is interpreted.": {
      "extractionState": "manual",
