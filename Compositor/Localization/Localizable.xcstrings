    "Zoom in (⌘+), now %@. At 100% each pixel of the JPEG is one pixel of the screen, as on the canvas": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大 (⌘+)，现在%@。 100% 时，JPEG 的每个像素都是屏幕的一个像素，就像在画布上一样"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ampliar (⌘+), ahora %@. Al 100% cada píxel del JPEG es un píxel de la pantalla, como en el lienzo"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ूम इन करें (⌘+), अब %@। 100% पर JPEG का प्रत्येक पिक्सेल स्क्रीन का एक पिक्सेल है, जैसा कि कैनवास पर है"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomez (⌘+), maintenant %@. A 100% chaque pixel du JPEG correspond à un pixel de l'écran, comme sur la toile"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كبّر الصورة (⌘+)، الآن %@. عند 100%، يمثل كل بكسل من JPEG بكسلًا واحدًا من الشاشة، كما هو الحال في اللوحة القماشية"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumente o zoom (⌘+), agora %@. A 100%, cada pixel do JPEG é um pixel da tela, como na tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Увеличьте масштаб (⌘+), теперь %@. При 100% каждый пиксель JPEG — это один пиксель экрана, как на холсте."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrandisci (⌘+), ora %@. Al 100% ogni pixel del JPEG è un pixel dello schermo, come sulla tela"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ズームイン (⌘+)、今度は %@ です。 100% では、JPEG の各ピクセルは、キャンバス上の場合と同様に、画面の 1 ピクセルになります。"
          }
        }
      }
    },
