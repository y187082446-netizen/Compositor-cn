    "Adds film grain, strongest in the middle tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加胶片颗粒，中间色调最强。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega grano de película, más fuerte en los tonos medios."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फिल्म ग्रेन जोड़ता है, मध्य स्वर में सबसे मजबूत।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute du grain au film, le plus fort dans les tons moyens."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف حبيبات الفيلم، الأقوى في النغمات الوسطى."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona granulação ao filme, mais forte nos tons médios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет зернистость пленки, наиболее выраженную в средних тонах."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge grana della pellicola, più forte nei toni medi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中間調に最も強いフィルムグレインを追加します。"
          }
        }
      }
    },
    "Adds green or magenta to the darkest tones.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在最暗的色调中添加绿色或洋红色。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
