    },
    "Bake keeps the current masked appearance in the dependent layers’ pixels. Remove Links reveals their pixels. You can undo either choice.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烘焙将当前蒙版外观保留在依赖层的像素中。删除链接会显示其像素。您可以撤消任一选择。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bake mantiene la apariencia enmascarada actual en los píxeles de las capas dependientes. Eliminar enlaces revela sus píxeles. Puede deshacer cualquiera de las opciones."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेक आश्रित परतों के पिक्सेल में वर्तमान नकाबपोश उपस्थिति को बनाए रखता है। लिंक हटाएँ से उनके पिक्सेल का पता चलता है। आप किसी भी विकल्प को पूर्ववत कर सकते हैं."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bake conserve l’apparence masquée actuelle dans les pixels des calques dépendants. Remove Links révèle leurs pixels. Vous pouvez annuler l’un ou l’autre choix."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ الخيار Bake على المظهر المقنع الحالي في وحدات بكسل الطبقات التابعة. إزالة الروابط تكشف عن وحدات البكسل الخاصة بها. يمكنك التراجع عن أي من الاختيارين."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bake mantém a aparência mascarada atual nos pixels das camadas dependentes. Remover links revela seus pixels. Você pode desfazer qualquer uma das opções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bake сохраняет текущий вид маски в пикселях зависимых слоев. Удалить ссылки раскрывает их пиксели. Вы можете отменить любой выбор."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bake mantiene l'aspetto mascherato corrente nei pixel dei livelli dipendenti. Rimuovi collegamenti rivela i relativi pixel. Puoi annullare entrambe le scelte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベイク処理により、依存レイヤーのピクセル内の現在のマスクされた外観が維持されます。リンクを削除すると、そのピクセルが表示されます。どちらの選択も取り消すことができます。"
          }
        }
      }
    },
