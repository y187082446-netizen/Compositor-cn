    "That selection is too detailed to outline. Try a different Tolerance, or turn on Contiguous.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该选择过于详细，无法概述。尝试不同的容差，或打开连续。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa selección es demasiado detallada para describirla. Pruebe con una tolerancia diferente o active Contiguo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह चयन इतना विस्तृत है कि उसकी रूपरेखा तैयार नहीं की जा सकती। एक अलग सहिष्णुता का प्रयास करें, या सन्निहित चालू करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sélection est trop détaillée pour être décrite. Essayez une autre tolérance ou activez Contigu."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التحديد مفصل جدًا بحيث لا يمكن تحديده. جرب تسامحًا مختلفًا، أو قم بتشغيل Contigously."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa seleção é muito detalhada para ser descrita. Experimente uma tolerância diferente ou ative Contíguo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот выбор слишком подробен, чтобы его можно было описать. Попробуйте другой допуск или включите параметр «Смежный»."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella selezione è troppo dettagliata per essere delineata. Prova una tolleranza diversa o attiva Contiguo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その選択は詳細すぎて概要を説明できません。別の許容値を試すか、連続をオンにしてください。"
          }
        }
      }
    },
    "The 2012 response. Calibration reaches most of the strength used by Version 6.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2012年的回应。校准达到了版本 6 使用的大部分强度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta de 2012. La calibración alcanza la mayor parte de la fuerza utilizada por la Versión 6."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2012 की प्रतिक्रिया. अंशांकन संस्करण 6 द्वारा उपयोग की गई अधिकांश शक्ति तक पहुँच जाता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse de 2012. L'étalonnage atteint la majeure partie de la force utilisée par la version 6."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رد 2012. تصل المعايرة إلى معظم القوة المستخدمة في الإصدار 6."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta de 2012. A calibração atinge a maior parte da força usada pela Versão 6."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ 2012 года. Калибровка достигает большей части силы, используемой в версии 6."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta del 2012. La calibrazione raggiunge la maggior parte dell'intensità utilizzata dalla versione 6."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2012年の回答。キャリブレーションは、バージョン 6 で使用される強度のほとんどに達します。"
          }
        }
      }
    },
    "The Photoshop file could not be read. It may be damaged or incomplete.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 Photoshop 文件。它可能已损坏或不完整。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo de Photoshop. Puede estar dañado o incompleto."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटोशॉप फ़ाइल पढ़ी नहीं जा सकी. यह क्षतिग्रस्त या अधूरा हो सकता है."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier Photoshop n'a pas pu être lu. Il peut être endommagé ou incomplet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
