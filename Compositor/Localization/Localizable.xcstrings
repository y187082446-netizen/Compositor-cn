    "Smudge and Liquify work on a layer's pixels, not its mask.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "涂抹和液化作用于图层的像素，而不是其蒙版。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Difuminar y Licuar funcionan en los píxeles de una capa, no en su máscara."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्मज और लिक्विफाई एक परत के पिक्सल पर काम करते हैं, उसके मास्क पर नहीं।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Smudge et Liquify fonctionnent sur les pixels d'un calque, pas sur son masque."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Smudge وLiquify على وحدات بكسل الطبقة، وليس على قناعها."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar e Dissolver funcionam nos pixels de uma camada, não em sua máscara."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Smudge и Liquify работают с пикселями слоя, а не с его маской."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sbavatura e Fluidifica funzionano sui pixel di un livello, non sulla sua maschera."
