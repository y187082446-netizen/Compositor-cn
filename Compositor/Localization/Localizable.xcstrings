        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيقوم Compositor بتحويل ميزات Photoshop هذه. لا يتم تطبيق أي شيء حتى تستمر."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
