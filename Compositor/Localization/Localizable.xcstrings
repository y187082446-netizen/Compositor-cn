    "How far a color may be from the picked ones and still be selected": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色与所选颜色相差多远但仍会被选择"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué tan lejos puede estar un color de los elegidos y aún así ser seleccionado"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई रंग चुने गए रंगों से कितना दूर हो सकता है और फिर भी चुना जा सकता है"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quelle mesure une couleur peut-elle être éloignée de celles sélectionnées et néanmoins être sélectionnée"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى أي مدى يمكن أن يكون اللون بعيدًا عن الألوان المختارة وما زال يتم تحديده"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A que distância uma cor pode estar das escolhidas e ainda assim ser selecionada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько цвет может быть далек от выбранных и при этом оставаться выбранным"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto un colore può distarsi da quelli scelti ed essere comunque selezionato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色からどれだけ離れていても選択される色があるか"
          }
        }
      }
    },
    "How far apart the screen's lines are": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕的线条相距多远"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué tan separadas están las líneas de la pantalla?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "How far apart the screen's lines are"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelle est la distance entre les lignes de l'écran"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدى تباعد خطوط الشاشة"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A que distância estão as linhas da tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как далеко друг от друга расположены линии экрана"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto sono distanti le linee dello schermo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンの線の間隔"
          }
        }
      }
    },
    "How far each color channel (0–255) can differ from the clicked color and still be selected": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个颜色通道 (0–255) 可以与单击的颜色相差多远，但仍会被选中"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En qué medida cada canal de color (0–255) puede diferir del color en el que se hizo clic y seguir seleccionado"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक रंग चैनल (0-255) क्लिक किए गए रंग से कितना भिन्न हो सकता है और फिर भी चुना जा सकता है"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans quelle mesure chaque canal de couleur (0 à 255) peut différer de la couleur cliquée tout en restant sélectionné"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى أي مدى يمكن أن تختلف كل قناة لون (0–255) عن اللون الذي تم النقر عليه وما زال من الممكن تحديده"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que ponto cada canal de cor (0–255) pode diferir da cor clicada e ainda assim ser selecionado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Насколько каждый цветовой канал (0–255) может отличаться от выбранного цвета и при этом оставаться выбранным"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di quanto ciascun canale di colore (0–255) può differire dal colore su cui si è fatto clic ed essere comunque selezionato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各カラー チャネル (0 ～ 255) がクリックされたカラーとどの程度異なっていても選択できるか"
          }
        }
      }
    },
    "How far from each edge the sharpening reaches, in pixels.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锐化距离每个边缘的距离（以像素为单位）。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A qué distancia de cada borde llega la nitidez, en píxeles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शार्पनिंग प्रत्येक किनारे से कितनी दूर तक पहुँचती है, पिक्सेल में।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quelle distance de chaque bord atteint la netteté, en pixels."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى أي مدى يصل الحد من كل حافة بالبكسل."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A que distância de cada borda chega a nitidez, em pixels."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как далеко от каждого края достигает резкости (в пикселях)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La distanza da ciascun bordo raggiunta dalla nitidezza, in pixel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シャープ化が各エッジからどれくらいの距離に達するか (ピクセル単位)。"
          }
        }
      }
    },
    "How far in brightness the adjustment reaches.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮度调节达到多远。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta dónde llega el brillo en el ajuste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समायोजन चमक में कहां तक पहुंचता है."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'où atteint le réglage de la luminosité."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى أي مدى يصل السطوع إلى التعديل."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Até que ponto o ajuste atinge o brilho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как далеко достигает регулировки яркости."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto in luminosità arriva la regolazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調整がどこまでの明るさになるか。"
          }
        }
      }
    },
