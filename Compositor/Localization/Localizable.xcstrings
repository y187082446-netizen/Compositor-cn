    "Image export supports canvases up to %@ megapixels and %@ pixels per side.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像导出支持画布高达 %@ 百万像素和每边 %@ 像素。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La exportación de imágenes admite lienzos de hasta %@ megapíxeles y %@ píxeles por lado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवि निर्यात प्रति पक्ष %@ मेगापिक्सेल और %@ पिक्सेल तक कैनवस का समर्थन करता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exportation d'images prend en charge les toiles jusqu'à %@ mégapixels et %@ pixels par côté."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم تصدير الصور اللوحات التي تصل إلى %@ ميجابكسل و%@ بكسل لكل جانب."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação de imagens suporta telas de até %@ megapixels e %@ pixels por lado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт изображений поддерживает холсты с разрешением до %@ мегапикселей и %@ пикселей на сторону."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esportazione delle immagini supporta tele fino a %@ megapixel e %@ pixel per lato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像のエクスポートは、最大 %@ メガピクセルおよび %@ ピクセル/辺までのキャンバスをサポートします。"
          }
        }
      }
    },
