            "state": "translated",
            "value": "右下"
          }
        }
      }
    },
    "Break the lines into glowing beads": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将线条分解成发光的珠子"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide las líneas en cuentas brillantes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेखाओं को चमकते मोतियों में तोड़ें"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brisez les lignes en perles lumineuses"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كسر الخطوط إلى حبات متوهجة"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quebre as linhas em contas brilhantes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разбейте линии на светящиеся бусинки"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rompi le linee in perline luminose"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線を壊して輝くビーズにします"
          }
        }
      }
    },
    "Brightens or darkens the corners to counter lens falloff.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使角落变亮或变暗以防止镜头衰减。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina u oscurece las esquinas para contrarrestar la caída de la lente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेंस के गिरने को रोकने के लिए कोनों को चमकीला या काला कर देता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclaircit ou assombrit les coins pour contrer l’atténuation de l’objectif."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيء أو يغمق الزوايا لمواجهة سقوط العدسة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina ou escurece os cantos para combater a queda da lente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Осветляет или затемняет углы, чтобы предотвратить затухание линзы."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiarisce o scurisce gli angoli per contrastare la caduta dell'obiettivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンズの減衰を防ぐためにコーナーを明るくまたは暗くします。"
          }
        }
      }
    },
    "Brightens or darkens the whole picture, in stops of light. Hold Option to see clipped highlights.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在光线停止时使整个图片变亮或变暗。按住 Option 可查看剪切的高光。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aclara u oscurece toda la imagen, en puntos de luz. Mantenga presionada la opción para ver los aspectos más destacados recortados."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रकाश के रुक-रुक कर पूरे चित्र को चमकीला या काला कर देता है। क्लिप किए गए हाइलाइट्स देखने के लिए विकल्प दबाए रखें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éclaircit ou assombrit l’ensemble de l’image, par niveaux de lumière. Maintenez Option pour voir les faits saillants coupés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيء أو يغمق الصورة بأكملها، في توقفات الضوء. اضغط مع الاستمرار على الخيار لرؤية النقاط البارزة المقطوعة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilumina ou escurece toda a imagem, em pontos de luz. Segure Opção para ver os destaques cortados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делает ярче или затемняет все изображение ступенями света. Удерживайте Option, чтобы увидеть обрезанные блики."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schiarisce o scurisce l'intera immagine, a intervalli di luce. Tieni premuto Opzione per vedere le luci ritagliate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光が止まると、写真全体が明るくなったり暗くなったりします。 Option を押し続けると、クリップされたハイライトが表示されます。"
          }
        }
      }
    },
    "Brightness added by this wheel.": {
