    "Keep the source moving with the brush between strokes; off starts every stroke at the source point": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在笔画之间保持源随画笔移动； off 从源点开始每个笔画"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga la fuente en movimiento con el pincel entre pasadas; off inicia cada trazo en el punto de origen"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्ट्रोक के बीच ब्रश से स्रोत को घुमाते रहें; स्रोत बिंदु पर प्रत्येक स्ट्रोक शुरू होता है"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez la source en mouvement avec le pinceau entre les coups ; off démarre chaque trait au point source"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمر في تحريك المصدر باستخدام الفرشاة بين الضربات؛ يبدأ إيقاف كل ضربة عند نقطة المصدر"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a fonte em movimento com o pincel entre as pinceladas; off inicia cada traço no ponto de origem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжайте перемещать источник вместе с кистью между мазками; off запускает каждый штрих в исходной точке"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni la fonte in movimento con il pennello tra una pennellata e l'altra; off avvia ogni tratto dal punto di origine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストローク間ではブラシを使ってソースを動かし続けます。 off はソース ポイントですべてのストロークを開始します。"
          }
        }
      }
    },
    "Keeps local contrast after luminance smoothing.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮度平滑后保持局部对比度。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene el contraste local después del suavizado de luminancia."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ल्यूमिनेंस स्मूथिंग के बाद स्थानीय कंट्रास्ट बनाए रखता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve le contraste local après le lissage de la luminance."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ على التباين المحلي بعد تجانس النصوع."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém o contraste local após a suavização da luminância."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет локальный контраст после сглаживания яркости."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene il contrasto locale dopo l'attenuazione della luminanza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輝度平滑化後も局所的なコントラストを維持します。"
          }
        }
      }
    },
    "Keeps this point fixed. Artwork is not scaled; cropped content remains outside the canvas.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持该点固定。艺术品未按比例缩放；裁剪后的内容保留在画布之外。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene este punto fijo. La obra de arte no está escalada; el contenido recortado permanece fuera del lienzo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बात को स्थिर रखता है. कलाकृति को स्केल नहीं किया गया है; क्रॉप की गई सामग्री कैनवास के बाहर रहती है."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient ce point fixe. Les illustrations ne sont pas mises à l'échelle ; le contenu recadré reste en dehors du canevas."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقي هذه النقطة ثابتة. لا يتم تحجيم العمل الفني؛ يبقى المحتوى الذي تم اقتصاصه خارج اللوحة القماشية."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém este ponto fixo. A arte não está dimensionada; o conteúdo recortado permanece fora da tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняет эту точку фиксированной. Работа не масштабируется; обрезанное содержимое остается за пределами холста."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene fisso questo punto. La grafica non è in scala; il contenuto ritagliato rimane fuori dall'area di disegno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この点は固定しておきます。アートワークは拡大縮小されません。切り取られたコンテンツはキャンバスの外側に残ります。"
          }
        }
      }
    },
