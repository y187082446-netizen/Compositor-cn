    "Only print dimensions and resolution change. Pixels stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅打印尺寸和分辨率发生变化。像素保持不变。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sólo cambian las dimensiones de impresión y la resolución. Los píxeles permanecen sin cambios."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल प्रिंट आयाम और रिज़ॉल्यूशन बदलता है। पिक्सेल अपरिवर्तित रहते हैं."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les dimensions d'impression et la résolution changent. Les pixels restent inchangés."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتغير أبعاد الطباعة ودقة الوضوح فقط. تبقى البكسلات دون تغيير."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as dimensões de impressão e a resolução mudam. Os pixels permanecem inalterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняются только размеры печати и разрешение. Пиксели остаются неизменными."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiano solo le dimensioni di stampa e la risoluzione. I pixel rimangono invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印刷寸法と解像度のみが変更されます。ピクセルは変化しません。"
          }
        }
      }
    },
