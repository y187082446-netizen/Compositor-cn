    "An image could not be saved. The previous project has not been replaced.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存图像。之前的项目没有被替换。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar una imagen. El proyecto anterior no ha sido reemplazado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक छवि सहेजी नहीं जा सकी. पिछले प्रोजेक्ट को प्रतिस्थापित नहीं किया गया है."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image n'a pas pu être enregistrée. Le projet précédent n'a pas été remplacé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حفظ الصورة. لم يتم استبدال المشروع السابق."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar uma imagem. O projeto anterior não foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить изображение. Предыдущий проект не был заменен."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare un'immagine. Il progetto precedente non è stato sostituito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を保存できませんでした。以前のプロジェクトは置き換えられていません。"
          }
        }
      }
    },
    "An image inside the project is missing or damaged. The current document has not been replaced.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目内的图像丢失或损坏。当前文档尚未被替换。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta una imagen dentro del proyecto o está dañada. El documento actual no ha sido reemplazado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट के अंदर एक छवि गायब या क्षतिग्रस्त है। वर्तमान दस्तावेज़ को प्रतिस्थापित नहीं किया गया है."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une image à l'intérieur du projet est manquante ou endommagée. Le document actuel n'a pas été remplacé."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صورة داخل المشروع مفقودة أو تالفة. لم يتم استبدال المستند الحالي."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma imagem dentro do projeto está faltando ou danificada. O documento atual não foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение внутри проекта отсутствует или повреждено. Действующий документ не заменен."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'immagine all'interno del progetto è mancante o danneggiata. Il documento attuale non è stato sostituito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクト内の画像が見つからないか破損しています。現在のドキュメントは置き換えられていません。"
          }
        }
      }
    },
    "Analyze the active layer only, or every visible layer as shown": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅分析活动图层，或如图所示的每个可见图层"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analice solo la capa activa, o cada capa visible como se muestra"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैसा कि दिखाया गया है, केवल सक्रिय परत या प्रत्येक दृश्यमान परत का विश्लेषण करें"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez le calque actif uniquement ou chaque calque visible comme indiqué"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحليل الطبقة النشطة فقط، أو كل طبقة مرئية كما هو موضح"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise apenas a camada ativa ou todas as camadas visíveis conforme mostrado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Анализируйте только активный слой или каждый видимый слой, как показано на рисунке."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza solo il livello attivo o ogni livello visibile come mostrato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
