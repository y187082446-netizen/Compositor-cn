    "Select only similar pixels connected to the one you click; off selects them everywhere": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅选择与您单击的像素相关的相似像素； off 到处选择它们"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione solo píxeles similares conectados al que hace clic; off los selecciona en todas partes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जिस पर क्लिक करते हैं उससे जुड़े केवल समान पिक्सेल का चयन करें; off उन्हें हर जगह चुनता है"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez uniquement les pixels similaires connectés à celui sur lequel vous cliquez ; off les sélectionne partout"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد فقط وحدات البكسل المشابهة المرتبطة بالبكسل الذي تنقر عليه؛ قبالة يختارهم في كل مكان"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione apenas pixels semelhantes conectados àquele em que você clica; off seleciona-os em todos os lugares"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбирайте только похожие пиксели, связанные с тем, на который вы нажимаете; off выбирает их везде"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona solo pixel simili collegati a quello su cui fai clic; off li seleziona ovunque"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックしたピクセルに接続されている類似したピクセルのみを選択します。 off はどこでもそれらを選択します"
          }
        }
      }
