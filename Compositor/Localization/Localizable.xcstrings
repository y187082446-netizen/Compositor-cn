    "Limits sharpening to stronger edges. Hold Option to see the mask.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将锐化限制为更强的边缘。按住 Option 可查看蒙版。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita el afilado a bordes más fuertes. Mantenga presionada la opción para ver la máscara."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तीक्ष्णता को मजबूत किनारों तक सीमित करता है। मास्क देखने के लिए विकल्प दबाए रखें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite l’affûtage aux bords plus forts. Maintenez Option pour voir le masque."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحد من الشحذ إلى حواف أقوى. اضغط باستمرار على الخيار لرؤية القناع."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
