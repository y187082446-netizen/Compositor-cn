        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы увеличить масштаб · Нажмите клавишу «Option», чтобы уменьшить масштаб · Перетащите вправо или влево, чтобы плавно масштабировать · Пробел для панорамирования"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per ingrandire · Fai clic tenendo premuto il tasto Opzione per rimpicciolire · Trascina a destra o a sinistra per eseguire lo zoom in modo fluido · Spazio per eseguire la panoramica"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックしてズームイン · Option キーを押しながらクリックしてズームアウト · 右または左にドラッグしてスムーズにズーム · スペースでパン"
          }
        }
      }
    },
