    "Text-editing shortcuts need Command, Option, or Control so they do not replace normal typing.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文本编辑快捷方式需要 Command、Option 或 Control，因此它们不会取代正常打字。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos de edición de texto necesitan Comando, Opción o Control para que no reemplacen la escritura normal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट-संपादन शॉर्टकट को कमांड, विकल्प या नियंत्रण की आवश्यकता होती है ताकि वे सामान्य टाइपिंग को प्रतिस्थापित न करें।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis d'édition de texte nécessitent Commande, Option ou Contrôle afin de ne pas remplacer la saisie normale."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج اختصارات تحرير النص إلى أمر أو خيار أو تحكم حتى لا تحل محل الكتابة العادية."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos de edição de texto precisam de Comando, Opção ou Controle para que não substituam a digitação normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ярлыков редактирования текста требуются команды Command, Option или Control, чтобы они не заменяли обычный ввод текста."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie per la modifica del testo richiedono Comando, Opzione o Controllo, quindi non sostituiscono la normale digitazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキスト編集のショートカットにはコマンド、オプション、またはコントロールが必要なので、通常の入力に代わるものではありません。"
          }
        }
      }
    },
