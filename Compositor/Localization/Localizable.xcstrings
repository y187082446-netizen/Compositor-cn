    "Weakens green fringes inside the green hue range.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "削弱绿色色调范围内的绿色条纹。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debilita las franjas verdes dentro del rango de tonalidad verde."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हरे रंग की सीमा के अंदर हरे किनारों को कमजोर करता है।"
          }
        },
        "fr": {
          "stringUnit": {
