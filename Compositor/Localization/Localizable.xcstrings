          "stringUnit": {
            "state": "translated",
            "value": "Hace que el color elegido sea más fuerte o más suave."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए रंग को मजबूत या शांत बनाता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rend la couleur choisie plus forte ou plus silencieuse."
