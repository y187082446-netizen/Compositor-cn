    "Diffusion is soft and wide, Bloom is tighter, and Halation is a red fringe.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "漫射柔和且宽广，光晕更紧密，光晕是红色边缘。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La difusión es suave y amplia, la floración es más densa y la halación es una franja roja."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रसार नरम और चौड़ा है, ब्लूम सख्त है, और हेलेशन एक लाल फ्रिंज है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La diffusion est douce et large, la floraison est plus serrée et le Halation est une frange rouge."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الانتشار ناعم وواسع، والزهرة أكثر إحكامًا، والهالة ذات هامش أحمر."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A difusão é suave e ampla, o Bloom é mais denso e o Halation é uma franja vermelha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusion — мягкий и широкий, Bloom — более плотный, а Halation — красная бахрома."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La diffusione è morbida e ampia, il Bloom è più stretto e l'Halation è una frangia rossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディフュージョンは柔らかくワイド、ブルームはよりタイト、ハレーションはレッドフリンジです。"
          }
        }
      }
    },
    "Dims the picture outside this color's range. It is not kept when you press OK.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使该颜色范围之外的图片变暗。当您按“确定”时，不会保留它。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenúa la imagen fuera del rango de este color. No se guarda cuando presiona OK."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस रंग की सीमा के बाहर चित्र को धुंधला कर देता है। जब आप ओके दबाते हैं तो यह नहीं रखा जाता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assombrit l'image en dehors de la plage de cette couleur. Il n'est pas conservé lorsque vous appuyez sur OK."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم بتعتيم الصورة خارج نطاق هذا اللون. ولا يتم الاحتفاظ به عند الضغط على OK."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escurece a imagem fora do intervalo desta cor. Não é mantido quando você pressiona OK."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затемнение изображения за пределами диапазона этого цвета. Он не сохраняется при нажатии ОК."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oscura l'immagine al di fuori della gamma di questo colore. Non viene mantenuto quando si preme OK."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この色の範囲外の画像を暗くします。 OKを押しても保持されません。"
          }
        }
      }
    },
