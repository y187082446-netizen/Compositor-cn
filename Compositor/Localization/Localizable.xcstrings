            "value": "取消链接图层和蒙版以分别移动或变换它们"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desvincula capa y máscara para moverlas o transformarlas por separado"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परत और मास्क को अलग-अलग स्थानांतरित करने या रूपांतरित करने के लिए उन्हें अनलिंक करें"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dissocier le calque et le masque pour les déplacer ou les transformer séparément"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بإلغاء ربط الطبقة والقناع لتحريكهما أو تحويلهما بشكل منفصل"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desvincule camada e máscara para movê-las ou transformá-las separadamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсоедините слой и маску, чтобы переместить или преобразовать их по отдельности."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scollega livello e maschera per spostarli o trasformarli separatamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイヤーとマスクのリンクを解除して、個別に移動または変形します"
          }
        }
      }
    },
