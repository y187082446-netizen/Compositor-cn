    "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每个大块像素绘制为实心正方形，或像点阵屏幕一样绘制为圆点"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja cada píxel grueso como un cuadrado sólido o como un punto redondo como una pantalla de matriz de puntos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक मोटे पिक्सेल को एक ठोस वर्ग के रूप में, या एक डॉट-मैट्रिक्स स्क्रीन की तरह एक गोल बिंदु के रूप में बनाएं"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez chaque gros pixel sous la forme d'un carré plein ou d'un point rond comme un écran matriciel"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم كل بكسل مكتنز كمربع صلب، أو كنقطة مستديرة مثل شاشة مصفوفة نقطية"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe cada pixel grosso como um quadrado sólido ou como um ponto redondo como uma tela de matriz de pontos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисуйте каждый крупный пиксель в виде сплошного квадрата или круглой точки, как на матричном экране."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna ogni grosso pixel come un quadrato solido o come un punto rotondo come uno schermo a matrice di punti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各分厚いピクセルを実線の正方形として、またはドットマトリックス スクリーンのような丸い点として描画します。"
          }
        }
      }
    },
    "Draw the marks for the light tones on the dark color, like a glowing screen": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色上画出浅色调的标记，就像发光的屏幕一样"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja las marcas de los tonos claros en el color oscuro, como una pantalla brillante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चमकती स्क्रीन की तरह, गहरे रंग पर हल्के टोन के निशान बनाएं"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessinez les marques des tons clairs sur la couleur sombre, comme un écran lumineux"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم علامات درجات الألوان الفاتحة على اللون الداكن، مثل شاشة متوهجة"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe as marcas dos tons claros na cor escura, como uma tela brilhante"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисуйте отметки светлых тонов на темном цвете, как светящийся экран."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna i segni per i toni chiari sul colore scuro, come uno schermo luminoso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗い色の上に、光る画面のように明るいトーンのマークを描きます"
          }
        }
      }
    },
    "Draw two or more lines on the preview that should be level or vertical.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览上绘制两条或多条水平或垂直的线。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja dos o más líneas en la vista previa que deben estar niveladas o verticales."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्वावलोकन पर दो या अधिक रेखाएँ बनाएँ जो समतल या लंबवत होनी चाहिए।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracez deux lignes ou plus sur l'aperçu qui doivent être de niveau ou verticales."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسم خطين أو أكثر في المعاينة بحيث يكونا مستويين أو رأسيين."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenhe duas ou mais linhas na visualização que devem estar niveladas ou verticais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нарисуйте две или более линий в предварительном просмотре, которые должны быть ровными или вертикальными."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna due o più linee sull'anteprima che dovrebbero essere livellate o verticali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー上に水平または垂直の 2 本以上の線を描きます。"
          }
        }
      }
    },
