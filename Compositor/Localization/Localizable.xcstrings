    "Shifts the glow from cool to warm. Halation stays red. Has no effect until Glow is raised.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将发光从冷色变为暖色。光晕保持红色。在光辉升起之前没有任何效果。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el brillo de frío a cálido. La halación permanece roja. No tiene ningún efecto hasta que se aumenta el resplandor."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चमक को ठंडे से गर्म में बदल देता है। हालेशन लाल रहता है. जब तक चमक नहीं बढ़ती तब तक कोई प्रभाव नहीं पड़ता।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait passer la lueur de froide à chaude. Halation reste rouge. N'a aucun effet jusqu'à ce que Glow soit augmenté."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحول التوهج من بارد إلى دافئ. هالة تبقى حمراء. ليس له أي تأثير حتى يتم رفع الوهج."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda o brilho de frio para quente. Halation permanece vermelho. Não tem efeito até que o brilho seja aumentado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняет свечение с холодного на теплое. Ореол остается красным. Не имеет эффекта, пока свечение не поднято."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la luminosità da fredda a calda. L'alone rimane rosso. Non ha effetto finché Glow non viene attivato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輝きを冷たいものから暖かいものに変えます。ハレーションは赤のままです。 Glowが上がるまで効果はありません。"
          }
        }
      }
    },
    "Shifts the picked color around the color wheel.": {
      "extractionState": "manual",
      "localizations": {
