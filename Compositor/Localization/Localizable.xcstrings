    "Auto balances the average color. Custom follows Temperature and Tint.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动平衡平均颜色。自定义遵循温度和色调。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto equilibra el color promedio. La personalización sigue la temperatura y el tinte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटो औसत रंग को संतुलित करता है। कस्टम तापमान और रंग का पालन करता है।"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Équilibre automatiquement la couleur moyenne. La personnalisation suit la température et la teinte."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم تلقائيًا بموازنة اللون المتوسط. مخصص يتبع درجة الحرارة والصبغة."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Equilibra automaticamente a cor média. O costume segue a temperatura e a tonalidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически балансирует средний цвет. Пользовательский выбор следует за температурой и оттенком."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilancia automaticamente il colore medio. La personalizzazione segue la temperatura e la tinta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均的な色のバランスを自動で調整します。カスタムは温度と色合いに従います。"
          }
        }
      }
    },
