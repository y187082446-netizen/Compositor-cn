        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجعل اللون المختار أقوى أو أكثر هدوءًا."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna a cor escolhida mais forte ou mais silenciosa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делает выбранный цвет сильнее или тише."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rende il colore selezionato più forte o più tenue."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した色を強くしたり、静かにしたりします。"
          }
        }
      }
    },
