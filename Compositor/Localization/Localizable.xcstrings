    "Light blooming around the lines, like a CRT's phosphors": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光线在线条周围绽放，就像 CRT 的荧光粉一样"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luz que florece alrededor de las líneas, como los fósforos de un CRT"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीआरटी के फॉस्फोरस की तरह, रेखाओं के चारों ओर प्रकाश खिल रहा है"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumière qui s'épanouit autour des lignes, comme les luminophores d'un tube cathodique"
