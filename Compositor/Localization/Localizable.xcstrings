    "Smooth selection edges; turn off for hard pixel edges": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平滑选区边缘；关闭硬像素边缘"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
